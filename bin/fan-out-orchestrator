#!/usr/bin/env -S node --experimental-strip-types
// The fan-out rail door. Runs detached; its log is the lane pane's content.
// Idle until a queue message: a log line, a pane wait, or the next
// deadline. No poll. AGENTIC_OS_CHECK_MS is only the watch-failure backstop.
// Thin door: the machinery lives in src/rail.ts (Rail), the engine in
// src/orchestrator.ts (runOrchestrator), the epilogue in Rail.run.
// Plain JS on purpose: this file has no extension, so Node will not
// type-strip it. The modules it imports are .ts and strip fine.
// Usage: bin/fan-out-orchestrator <taskDir>
import { resolve } from "node:path"
import { runOrchestrator } from "../src/orchestrator.ts"
import { Rail } from "../src/rail.ts"
import { liveSpawnerSessionIds } from "../src/store.ts"

const argvDir = process.argv[2] ? resolve(process.argv[2]) : null
const rail = new Rail({ argvDir, workflow: "fan-out" })
const ledger = rail.ledger
rail.writePermissions() // per-run opencode.json: no external-dir prompts inside this run
// SIGINT aborts. SIGTERM is the engine's drain — runOrchestrator traps
// it, drains to a unit boundary, and parks paused (ADR 5). SIGKILL is
// uncatchable: the abort verb's own.
rail.trapSignals()

// Booked wait (ADR 0006): a unit's pane whose booked session a
// running child spur names as its spawner is idle on purpose — the
// stall clock stands down while the child runs. Disk-derived set,
// memoized briefly so stall checks stay cheap.
let spawnIdsAt = 0
let spawnIds = new Set()
const spawnerSessions = () => {
  if (Date.now() - spawnIdsAt > 10_000) {
    spawnIds = liveSpawnerSessionIds()
    spawnIdsAt = Date.now()
  }
  return spawnIds
}
const bookedWait = (unitId) => {
  if (!ledger) return false
  const pane = ledger.job.panes.find((p) => p.label === rail.scopedName(`w-${unitId}`))
  const sid = pane?.transcript?.session_id
  return sid ? spawnerSessions().has(sid) : false
}

const engine = () => {
  // ADR 5: unfinished units of an earlier generation resume from the
  // pane ledger — the latest pane record per unfinished unit carries the
  // booked session pointer (write-ahead at spawn, session id at birth).
  const resumes = rail.resumesForUnfinished()
  if (resumes.size > 0) {
    rail.log(`continue: ${resumes.size} parked unit(s) resume from booked panes (${[...resumes.values()].filter((s) => s.session_id).length} with a session id)`)
  }
  return runOrchestrator({
    taskDir: rail.taskDir,
    shep: rail,
    checkMs: Number(process.env.AGENTIC_OS_CHECK_MS ?? "") || undefined,
    slots: Number(process.env.AGENTIC_OS_SLOTS ?? "") || undefined,
    drainMs: Number(process.env.AGENTIC_OS_DRAIN_MS ?? "") || undefined,
    resumes,
    bookedWait,
    emit: (kind, payload) => ledger?.emit(kind, payload),
    existingRows: rail.existingRows(),
    worktree: process.env.AGENTIC_OS_WORKTREE || ledger?.job.worktree,
    canary: process.env.AGENTIC_OS_CANARY !== "0",
  })
}
// a lab-kind run belongs to bin/lab-orchestrator — refuse before any
// booking (exit 2, no abort: nothing was run)
if (rail.liveWorkflow()) {
  rail.log("refusing: kind lab is bin/lab-orchestrator, not fan-out")
  process.exit(2)
}

process.exit(await rail.run(engine))
