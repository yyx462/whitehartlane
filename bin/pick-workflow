#!/usr/bin/env bash
# Copied call shape from yyx_jev. Not the skill. The question is the product policy.
# The question and criteria are the jev-tuner's landed winner
# (src/jev-prompts/workflow-choice.*) — fallback embedded below.
# Auth is read from the same files jev uses. The value is never printed.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
PROMPT_FILE="$HERE/../src/jev-prompts/workflow-choice.txt"
META_FILE="$HERE/../src/jev-prompts/workflow-choice.json"
QUESTION="Is this task a bag of independent units, such as separate web searches, where no unit needs another's result?"
CRIT_FANOUT="The task is independent units. No unit needs another unit's result."
CRIT_DIRECT="The task is one piece of work, like a coding change in one chat."
[ -s "$PROMPT_FILE" ] && QUESTION="$(tr -d '\n' < "$PROMPT_FILE" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
if [ -s "$META_FILE" ]; then
  J="$(jq -r '.options["fan-out"] // empty' "$META_FILE")"; [ -n "$J" ] && CRIT_FANOUT="$J"
  J="$(jq -r '.options.direct // empty' "$META_FILE")"; [ -n "$J" ] && CRIT_DIRECT="$J"
fi
DRY=0
STATE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --state) STATE="${2:-}"; shift 2 ;;
    *) STATE="$1"; shift ;;
  esac
done

cfg() {
  local var="$1" f line
  [ -n "${!var:-}" ] && { printf '%s' "${!var}"; return; }
  for f in "$HOME/.config/jev/env" "$HOME/.secrets/env"; do
    [ -f "$f" ] || continue
    line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${var}=" "$f" 2>/dev/null | tail -n 1)"
    [ -n "$line" ] || continue
    line="${line#*=}"
    case "$line" in
      \"*\") line="${line#\"}"; line="${line%\"}" ;;
      \'*\') line="${line#\'}"; line="${line%\'}" ;;
    esac
    printf '%s' "$line"
    return
  done
}

REQ="$(jq -n --arg state "$STATE" --arg q "$QUESTION" --arg fanout "$CRIT_FANOUT" --arg direct "$CRIT_DIRECT" '{
  model: "jev-1.14",
  state: $state,
  questions: {
    q: {
      type: "choice",
      instructions: $q,
      criteria: {
        "fan-out": $fanout,
        "direct": $direct
      }
    }
  }
}')"

if [ "$DRY" = 1 ]; then
  printf '%s\n' "$REQ"
  exit 0
fi

KEY="$(cfg AIHUBMIX_API_KEY)"
BASE="$(cfg JEV_BASE_URL)"
[ -n "$BASE" ] || BASE="https://api.inferera.com/v1"
[ -n "$KEY" ] || { printf 'error: AIHUBMIX_API_KEY unset\n' >&2; exit 1; }

post() { # post <extra curl args...> — response body or nothing on failure
  curl -sS -m 12 -X POST "$BASE/systemone" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $KEY" \
    --data-binary "$REQ" "$@" 2>/dev/null
}

BODY="$(post)" 
if [ -z "$BODY" ]; then
  # The env proxy (Clash) can kill the TLS tunnel while direct works;
  # retry bypassing the proxy before giving up.
  BODY="$(post --noproxy '*')"
fi
[ -n "$BODY" ] || { printf 'error: jev unreachable via proxy and direct (%s)\n' "$BASE" >&2; exit 1; }

CHOICE="$(printf '%s' "$BODY" | jq -r '.answers.q.choice // empty')"
CONF="$(printf '%s' "$BODY" | jq -r '.answers.q.confidence // empty')"
[ -n "$CHOICE" ] || { printf 'error: jev returned no choice\n' >&2; exit 1; }
printf '%s %s\n' "$CHOICE" "$CONF"
