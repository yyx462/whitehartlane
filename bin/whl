#!/usr/bin/env bash
# whl — the white hart lane door to agentic-os (see ADR 0006).
# A thin, honest shim: every verb passes through to the agentic-os door
# unchanged. The name exists so every project folder can say
#   whl run <folder> --from <tool>:<session-id>
# and mean it — the levy (the calling main agent) commissions a spur,
# walks away, and receives exactly one wake when the spur ends.
#
# Door resolution: the checkout this file lives in, and only if its deps
# are present (the door imports smol-toml). A bare checkout without
# node_modules is skipped, not suffered.
set -euo pipefail
self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(cd "$(dirname "$self")" && pwd)"
root="$(cd "$here/.." && pwd)"
door_ok() {
  [[ -f "$1" && -d "$(dirname "$1")/../node_modules/smol-toml" ]]
}
door=""
if door_ok "$root/bin/agentic-os"; then door="$root/bin/agentic-os"; fi
if [[ -z "$door" ]]; then
  echo "whl: no agentic-os door with dependencies found in $root" >&2
  echo "whl: run npm ci in the agentic-os checkout first" >&2
  exit 1
fi
exec node --experimental-strip-types "$door" "$@"
