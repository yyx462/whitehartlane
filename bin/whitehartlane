#!/usr/bin/env -S node --experimental-strip-types
// whitehartlane run <folder> | jobs | events | audit | sweep | pause | abort |
// fail | continue | regrade | fork | register | promote | plugin install|uninstall|status — the start door is run. It reads workflow.toml and
// starts that workflow's engine. The rest read and finish the OS disk
// (~/.local/share/whitehartlane). jobs lists every Job record with its state
// and receipt; audit diffs live shep panes against booked panes (every
// pane is born booked — a live pane no Job admits is a violation); sweep
// parks running Jobs whose orchestrator died without a graceful stop in
// the ask-first queue — orphaned, not aborted, never auto-resurrected;
// pause SIGTERMs a live orchestrator, which drains to its boundary and
// books paused (ADR 5); abort kills immediately (SIGKILL — sessions stay
// booked for a later continue); continue rebirths a paused/aborted/
// orphaned Job from its booked session pointers (the old relaunch,
// absorbed — M3: no cap, a soft continued ×N counter); fork delivers a
// booked wake into a reborn levy pane (ADR 0006 §3 — the spawner seed
// resumed from the checkpoint, the wake as the first prompt).
import { execFileSync, spawn } from "node:child_process"
import { copyFileSync, existsSync, mkdirSync, openSync, readFileSync, realpathSync, rmSync, symlinkSync, writeFileSync } from "node:fs"
import { homedir } from "node:os"
import { join } from "node:path"
import { fileURLToPath } from "node:url"
/** @typedef {import("../src/store.ts").JobRecord} JobRecord */
import { prepareRun, spawnerFromArgs } from "../src/run.ts"
import { refreshWait } from "../src/refresh.ts"
import { defaultRunner, jsonAt } from "../src/runners.ts"
import { orchestratorBin } from "../src/workflow-kind.ts"
import { forkLevy } from "../src/fork.ts"
import { regradeJob } from "../src/resume.ts"
import { allLevyPanes, levyPaneByPane, registerLevyPane } from "../src/levy-pane.ts"
import { seedSessionFile } from "../src/transcripts.ts"
import { admitFork } from "../src/policy.ts"
import {
  abortJob,
  appendEvent,
  continueJob,
  eventsPath,
  failJob,
  findOrOpenSession,
  homeRoot,
  killPane,
  leaseExpired,
  listJobs,
  loadJob,
  normalizeSpur,
  orphanJob,
  readAllEvents,
  readEvents,
  saveJob,
  wakeAudit,
} from "../src/store.ts"
import { formatGate, markPromoted, promoteFindings, submitPr, worktreeHasWork } from "../src/promote.ts"

// "90s", "2m", "1h", "5000" (ms) — the pause --wait one-shot ceiling.
function parseDuration(raw) {
  const m = /^(\d+)(ms|s|m|h)?$/.exec(String(raw ?? ""))
  if (!m) return null
  const scale = { ms: 1, s: 1000, m: 60_000, h: 3_600_000, "": 1 }[m[2] ?? ""] ?? 1
  const ms = Number(m[1]) * scale
  return Number.isFinite(ms) && ms > 0 ? ms : null
}

/** @typedef {{ label: string, pane: string }} LivePane */

/** @returns {LivePane[]} */
function shepStatus() {
  try {
    const out = execFileSync("shep", ["status"], { encoding: "utf8", timeout: 30_000 })
    return out
      .split("\n")
      .map((line) => line.trim())
      .filter((line) => line && !line.startsWith("name ") && !line.startsWith("status:"))
      .map((line) => {
        const [label, pane] = line.split(/\s+/)
        return { label, pane }
      })
      .filter((p) => p.label && p.pane)
  } catch {
    return []
  }
}

// the runner seam (src/runners.ts): one place the external CLIs are
// dialed — shared with the Rail, swappable when the substrate changes
const herdrAt = defaultRunner("herdr")

/** @param {number | undefined} pid */
function pidAlive(pid) {
  if (!pid) return false
  try {
    process.kill(pid, 0)
    return true
  } catch (err) {
    return err?.code === "EPERM"
  }
}

/** @param {JobRecord} job */
function unitsOf(job) {
  try {
    const state = JSON.parse(readFileSync(join(job.dir, "state.json"), "utf8"))
    return { done: state.done?.length ?? 0, failed: state.failed?.length ?? 0 }
  } catch {
    return null
  }
}

/** @param {JobRecord[]} jobs */
function fmtJobs(jobs) {
  const rows = jobs.map((job) => {
    const units = unitsOf(job)
    const born = job.panes.length
    const dead = job.panes.filter((p) => p.died).length
    const outcome = job.receipt
      ? `receipt ${job.receipt.panesRemaining} left, ${job.receipt.unitsDone ?? "?"} done`
      : job.abort
        ? `aborted: ${job.abort.reason} — continue?`
        : job.orphan
          ? `orphaned: ${job.orphan.reason} — continue?`
          : job.pause
            ? `paused: ${job.pause.reason} — continue?`
            : "in flight"
    return [
      job.id.padEnd(9),
      job.state.padEnd(8),
      `${job.workflow} by ${job.stoodUpBy}`.padEnd(22),
      units ? `u ${units.done}d/${units.failed}f` : "u -",
      `p ${dead}/${born}`,
      `${job.continues ? `×${job.continues} ` : ""}${outcome}`,
      job.dir,
    ].join("  ")
  })
  return [`job      state    stood up by           units    panes   outcome                     dir`, ...rows].join("\n")
}

/** @param {JobRecord} job @param {LivePane[]} live */
function livePanesOf(job, live) {
  const labels = new Set(job.panes.map((p) => p.label))
  return live.filter((p) => labels.has(p.label))
}

async function main() {
  const cmd = process.argv[2]
  const jobs = listJobs()

  // renewal-by-presence (ADR 0008): living in a registered levy pane
  // and using the door IS the heartbeat — touch the registration.
  if (process.env.HERDR_PANE_ID) {
    const reg = levyPaneByPane(process.env.HERDR_PANE_ID)
    if (reg) registerLevyPane({ ...reg, at: new Date().toISOString() })
  }

  if (cmd === "run") {
    const args = process.argv.slice(3)
    const verbose = args.includes("--verbose")
    // ADR 0006: --from <tool>:<session-id> books the spawning levy
    // as the checkpoint — the Job will wake it once at the end. Inside
    // herdr the pane rides along (HERDR_PANE_ID or --pane): the wake's
    // parent-pane rung prompts it in-band when the Job finishes.
    const fromIdx = args.indexOf("--from")
    const spawner = spawnerFromArgs(args)
    if (fromIdx !== -1 && !spawner) {
      console.error("run: --from wants <tool>:<session-id>, e.g. --from opencode:ses_01abc")
      process.exitCode = 2
      return
    }
    // A Job nobody hears finishing is an information gap (j-b6067c:
    // levied without --from, its end reached nobody). Book a levy by
    // default; the humanless path is an explicit choice, not a
    // forgotten flag.
    const unattended = args.includes("--unattended")
    if (!spawner && !unattended) {
      console.error("run: no levy booked — pass --from <tool>:<session-id> (the Job wakes it exactly once at the end),")
      console.error("run: or --unattended if truly nobody waits. The durable receipt lands either way; the wake is the gap you are closing.")
      process.exitCode = 2
      return
    }
    const paneIdx = args.indexOf("--pane")
    const folder = args.find(
      (arg, i) =>
        !arg.startsWith("-") &&
        !(fromIdx !== -1 && i === fromIdx + 1) &&
        !(paneIdx !== -1 && i === paneIdx + 1),
    )
    if (!folder) {
      console.error("usage: whitehartlane run <folder> [--from <tool>:<session-id>] [--pane <pane-id>] [--verbose]")
      process.exitCode = 2
      return
    }
    const ready = prepareRun(folder)
    if (!ready.ok) {
      console.error(`run: ${ready.why}`)
      process.exitCode = ready.code
      return
    }
    if (spawner) {
      ready.job.spawner = spawner
      saveJob(ready.job)
    }
    const orchestrator = process.env.AGENTIC_OS_ORCHESTRATOR ?? join(import.meta.dirname, orchestratorBin(ready.kind))
    if (!existsSync(orchestrator)) {
      abortJob(ready.job, `no orchestrator at ${orchestrator}`, 0, "cli")
      console.error(`run: no orchestrator at ${orchestrator}`)
      process.exitCode = 1
      return
    }
    const logFd = openSync(ready.log, "a")
    const child = spawn(process.execPath, ["--experimental-strip-types", orchestrator, ready.job.dir], {
      detached: true,
      stdio: ["ignore", logFd, logFd],
      env: {
        ...process.env,
        AGENTIC_OS_SID: ready.job.sid,
        AGENTIC_OS_JID: ready.job.id,
        ...(verbose ? { AGENTIC_OS_VERBOSE: "1" } : {}),
      },
    })
    child.unref()
    ready.job.pid = child.pid
    saveJob(ready.job)
    console.log(`job: ${ready.job.id}`)
    console.log(`workflow: ${ready.kind}`)
    if (ready.job.spur ?? ready.job.dag) {
      const d = normalizeSpur(ready.job.spur ?? ready.job.dag)
      if (d) {
        const labels = Object.entries(d.labels ?? {}).map(([k, v]) => ` ${k}:${v}`).join("")
        console.log(`spur: ${d.project}/${d.spur_id} version ${d.content_hash}${labels}`)
      }
    }
    for (const w of ready.warnings) console.error(`warning: ${w}`)
    console.log(`log: ${ready.log}`)
    console.log(`trace: ${ready.trace}`)
    return
  }

  if (cmd === "jobs" || !cmd) {
    if (jobs.length === 0) {
      console.log("no Jobs on the OS disk")
      return
    }
    console.log(fmtJobs(jobs))
    return
  }

  if (cmd === "events") {
    const sid = process.argv[3]
    const streams = sid ? [{ sid, events: readEvents(sid) }] : readAllEvents()
    let total = 0
    for (const { sid: s, events } of streams) {
      if (events.length === 0) continue
      console.log(`== session ${s} (${events.length} events)`)
      for (const e of events) console.log(JSON.stringify(e))
      total += events.length
    }
    console.log(`events: ${total} across ${streams.filter((x) => x.events.length).length} session(s)`)
    return
  }

  if (cmd === "audit") {
    const live = shepStatus()
    const admitted = new Set([
      ...jobs.flatMap((job) => job.panes.map((p) => p.label)),
      ...allLevyPanes().map((r) => r.pane),
    ])
    const bastards = live.filter((p) => !admitted.has(p.label))
    const stalled = jobs.filter((job) => job.state === "running" && !pidAlive(job.pid))
    console.log(`panes live in shep: ${live.length}; admitted by Jobs: ${live.length - bastards.length}`)
    for (const pane of bastards) {
      console.log(`UNADMITTED ${pane.label} (${pane.pane}) — no booked birth; retire it: shep retire ${pane.label}`)
    }
    for (const job of stalled) {
      console.log(`STALLED ${job.id} — orchestrator pid ${job.pid} is gone; run: whitehartlane sweep`)
    }
    // ADR 0010 — the doorbell is a last resort, never a silent one:
    // every wake that fell out of band (and was never consumed) is
    // named here, with the fork rung's diagnosis and the drain verb
    const outOfBand = wakeAudit(jobs)
    for (const row of outOfBand.slice(0, 10)) {
      console.log(`OUT-OF-BAND wake ${row.jid} (${row.task}) — ${row.delivery} at ${row.at}: ${row.why}; drain it: whitehartlane fork ${row.jid}`)
    }
    const dirty = bastards.length + stalled.length + outOfBand.length
    console.log(
      dirty === 0
        ? "audit: clean"
        : `audit: ${bastards.length} unadmitted, ${stalled.length} stalled, ${outOfBand.length} out-of-band wake(s)`,
    )
    process.exitCode = dirty === 0 ? 0 : 1
    return
  }

  if (cmd === "sweep") {
    const live = shepStatus()
    let swept = 0
    for (const job of jobs) {
      if (job.state !== "running") continue
      // Issue #123 — the sweep's oracle is the holder pid first; pure
      // lease expiry (a wedged-but-alive orchestrator) is opt-in via
      // AGENTIC_OS_LEASE_ENFORCE=1 until beat density is proven across
      // quiet fan-out waits. Timers grant the right to suspect; the
      // census decides.
      const pidGone = !pidAlive(job.pid)
      const leaseGone =
        process.env.AGENTIC_OS_LEASE_ENFORCE === "1" && leaseExpired(job)
      if (!pidGone && !leaseGone) {
        if (leaseExpired(job)) {
          console.log(`${job.id} lease expired at ${job.lease?.expires} but pid ${job.pid} is alive — watched, not swept (AGENTIC_OS_LEASE_ENFORCE=1 to act)`)
        } else {
          console.log(`${job.id} running (pid ${job.pid}) — left alone`)
        }
        continue
      }
      // single-act: re-read the record — another sweep (or the
      // orchestrator's own epilogue) may have flipped the state since
      // this list was built; orphanJob no-ops on non-running either way
      const fresh = loadJob(job.sid, job.id) ?? job
      if (fresh.state !== "running") continue
      const orphans = livePanesOf(fresh, live)
      orphanJob(fresh, pidGone ? `orchestrator pid ${fresh.pid ?? "?"} gone` : `lease expired at ${fresh.lease?.expires}`, orphans.length)
      swept += 1
      console.log(`${fresh.id} orphaned (parked, ask-first) — ${fresh.dir}`)
      console.log(`  continue: whitehartlane continue ${fresh.id} | decline: whitehartlane abort ${fresh.id}`)
      if (orphans.length > 0) {
        console.log(`  straggler panes still live (continue retires them): ${orphans.map((p) => p.label).join(", ")}`)
      }
    }
    console.log(swept === 0 ? "sweep: nothing to finish" : `sweep: ${swept} Job(s) parked for a continue decision`)
    return
  }

  if (cmd === "promote") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`promote: no such Job '${jid ?? ""}'`)
      process.exitCode = 2
      return
    }
    const findings = promoteFindings({
      job,
      worktreeExists: job.worktree ? existsSync(job.worktree) : false,
      hasWork: job.worktree ? worktreeHasWork(job.worktree) : false,
    })
    if (findings.length > 0) {
      console.log(formatGate(job.id, findings))
      process.exitCode = 1
      return
    }
    const title = job.task.split("\n")[0].slice(0, 72)
    const body = [
      job.task,
      "",
      `Job ${job.id} retired ${job.receipt?.status}. Panes remaining ${job.receipt?.panesRemaining}.`,
      "Opened by whitehartlane promote. Not merged.",
    ].join("\n")
    let note = ""
    try {
      note = submitPr(job.worktree, title, body).split("\n").slice(-3).join(" ")
    } catch (err) {
      console.log(formatGate(job.id, [{ check: "pr", detail: err instanceof Error ? err.message.split("\n")[0] : String(err) }]))
      process.exitCode = 1
      return
    }
    markPromoted(job, note || "pr opened")
    console.log(formatGate(job.id, [], note || "opened"))
    return
  }

  // refresh: a person asked the running orchestrator to get out of the
  // way so the current door can take the job. Drain to paused, then
  // continue. Never automatic. A ceiling miss does not continue.
  if (cmd === "refresh") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`refresh: no such Job '${jid ?? ""}'`)
      process.exitCode = 2
      return
    }
    if (job.state !== "running" || !pidAlive(job.pid)) {
      console.error(`refresh: ${job.id} is ${job.state}${job.pid ? " (orchestrator not live)" : ""} — only a running Job refreshes. A parked one is continue.`)
      process.exitCode = 2
      return
    }
    const ceiling = 10 * 60_000
    writeFileSync(join(job.dir, "drain.deadline"), new Date(Date.now() + ceiling).toISOString())
    try {
      process.kill(job.pid, "SIGTERM")
    } catch (err) {
      console.error(`refresh: could not signal pid ${job.pid} (${err.message})`)
      process.exitCode = 1
      return
    }
    console.log(`refresh: draining ${job.id} (pid ${job.pid}) — continue follows only after it books paused`)
    const started = Date.now()
    let fresh = job
    for (;;) {
      fresh = loadJob(job.sid, job.id) ?? fresh
      const step = refreshWait(fresh.state, Date.now() - started, ceiling)
      if (step === "wait") {
        Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 500)
        continue
      }
      if (step === "timeout") {
        console.error(`refresh: drain did not park within ${ceiling}ms — not continued. Abort, then continue, if you want to force it.`)
        process.exitCode = 1
        return
      }
      if (step === "stopped") {
        console.error(`refresh: ${job.id} left the drain as ${fresh.state} — not continued`)
        process.exitCode = 1
        return
      }
      break
    }
    for (const pane of fresh.panes.filter((p) => p.died === undefined)) {
      try {
        execFileSync("shep", ["retire", pane.label], { timeout: 30_000 })
      } catch {}
      killPane(fresh, pane.label)
    }
    const orchestrator = join(import.meta.dirname, orchestratorBin(fresh.workflow))
    const logFd = openSync(join(fresh.dir, "orchestrator.log"), "a")
    const child = spawn(process.execPath, ["--experimental-strip-types", orchestrator, fresh.dir], {
      detached: true,
      stdio: ["ignore", logFd, logFd],
      env: { ...process.env, AGENTIC_OS_SID: fresh.sid, AGENTIC_OS_JID: fresh.id },
    })
    child.unref()
    continueJob(fresh, child.pid)
    console.log(`refreshed ${fresh.id} (pid ${child.pid}, ×${fresh.continues ?? 1}) — new door, sessions resumed — log: ${join(fresh.dir, "orchestrator.log")}`)
    return
  }

  // pause (ADR 5): SIGTERM is the drain — the orchestrator stops
  // claiming, lets in-flight units finish, retires its panes, and
  // books paused. --wait is a one-shot drain-ceiling override (2m, 90s).
  if (cmd === "pause") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`pause: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (job.state !== "running" || !pidAlive(job.pid)) {
      console.error(`pause: ${job.id} is ${job.state}${job.pid ? " (orchestrator not live)" : ""} — only a running Job can pause`)
      process.exitCode = 2
      return
    }
    const waitIdx = process.argv.indexOf("--wait")
    if (waitIdx !== -1) {
      const ms = parseDuration(process.argv[waitIdx + 1])
      if (ms === null) {
        console.error("pause: --wait wants a duration like 2m or 90s")
        process.exitCode = 2
        return
      }
      writeFileSync(join(job.dir, "drain.deadline"), new Date(Date.now() + ms).toISOString())
    }
    try {
      process.kill(job.pid, "SIGTERM")
      console.log(`pause: signalled orchestrator pid ${job.pid} — ${job.id} drains to a boundary, then books paused`)
    } catch (err) {
      console.error(`pause: could not signal pid ${job.pid} (${err.message})`)
      process.exitCode = 1
    }
    return
  }

  // continue (ADR 5): the reborn verb — paused, aborted, and orphaned
  // all continue the same way. Stragglers retire first (a live pane
  // from the parked generation would double-write a unit dir), then
  // the orchestrator resumes unfinished units from booked session
  // pointers. Deliberate and typed; the counter warns, never blocks.
  // (Absorbs the old relaunch: same straggler-retire + respawn path,
  // no cap — M3.)
  if (cmd === "continue") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`continue: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (job.state !== "paused" && job.state !== "aborted" && job.state !== "orphaned") {
      console.error(`continue: ${job.id} is ${job.state}, not paused/aborted/orphaned`)
      process.exitCode = 2
      return
    }
    for (const pane of job.panes.filter((p) => p.died === undefined)) {
      try {
        execFileSync("shep", ["retire", pane.label], { timeout: 30_000 })
      } catch {}
      killPane(job, pane.label)
    }
    const orchestrator = join(import.meta.dirname, orchestratorBin(job.workflow))
    const logFd = openSync(join(job.dir, "orchestrator.log"), "a")
    const child = spawn(process.execPath, ["--experimental-strip-types", orchestrator, job.dir], {
      detached: true,
      stdio: ["ignore", logFd, logFd],
      env: { ...process.env, AGENTIC_OS_SID: job.sid, AGENTIC_OS_JID: job.id },
    })
    child.unref()
    continueJob(job, child.pid)
    console.log(`continued ${job.id} (pid ${child.pid}, ×${job.continues ?? 1}) — unfinished units resume from booked sessions — log: ${join(job.dir, "orchestrator.log")}`)
    return
  }

  // regrade (#144): the minimal-rerun resume for a TERMINAL job. Units
  // that failed at the GRADE stage (worker output on disk, verdict bad
  // or faulty) re-enter at exactly that card — the worker never runs
  // again; the levy fixes/blesses the hook first, then one verb turns
  // mislabeled stops into honest reports. Units without worker output
  // say so: they want a rerun (fresh booking), not a regrade.
  if (cmd === "regrade") {
    const jid = process.argv[3]
    if (!jid) {
      console.error("regrade: wants a job id — whitehartlane regrade j-xxxx")
      process.exitCode = 2
      return
    }
    const r = regradeJob(jid)
    if (!r.ok) {
      console.error(`regrade: ${r.why}`)
      process.exitCode = 1
      return
    }
    if (r.regraded.length === 0) {
      console.log(`regrade ${jid}: nothing failed — report stands (${r.report?.status ?? "none"})`)
      return
    }
    for (const row of r.regraded) {
      console.log(`regrade ${jid}: ${row.unit} → ${row.pass ? "PASS" : "FAIL"} (${row.row})`)
    }
    if (r.needsRerun.length > 0) {
      console.log(`regrade ${jid}: ${r.needsRerun.join(", ")} lack worker output — rerun (a fresh booking spares done units)`)
    }
    console.log(`regrade ${jid}: report ${r.report?.status} at ${r.dir ? join(r.dir, "report.json") : "(run dir)"}`)
    return
  }

  // fork (ADR 0006 §3): deliver a booked wake into a reborn levy pane.
  // The seed is the spawner pointer — the levy's host session resumed
  // from the spawn checkpoint — and the wake message is the pane's
  // first prompt. Booked on the levy's session trace (the pane belongs
  // to the levy, not to the spur's Job); the spur records consumption.
  if (cmd === "fork") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`fork: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (!job.spawner) {
      console.error(`fork: ${job.id} is unattended — no levy to fork`)
      process.exitCode = 2
      return
    }
    const wakePath = join(job.dir, "wake.json")
    if (!existsSync(wakePath)) {
      console.error(`fork: ${job.id} has no booked wake (state ${job.state}) — only a finished or parked spur wakes its levy`)
      process.exitCode = 2
      return
    }
    let wake
    try {
      wake = JSON.parse(readFileSync(wakePath, "utf8"))
    } catch (err) {
      console.error(`fork: wake.json unreadable (${err instanceof Error ? err.message : String(err)})`)
      process.exitCode = 1
      return
    }
    const seedFile = seedSessionFile(job.spawner)
    const admission = admitFork({
      seed: { ...job.spawner, ...(seedFile ? { session_file: seedFile } : {}) },
      fileExists: (p) => existsSync(p),
    })
    if (!admission.admit) {
      console.error(`fork: the seed does not resolve — ${admission.why}`)
      console.error(`fork: the durable wake stays at ${wakePath}`)
      process.exitCode = 1
      return
    }
    // the birth body is forkLevy's — the same ladder the rail's wake
    // uses (targeted placement beside the levy when its pane lives,
    // a workspace-scoped tab otherwise, courier reaper, receipt). The
    // verb adds only what a human at the door needs: prints + booking.
    const outcome = forkLevy(job, { message: wake.message })
    if (!outcome.ok) {
      console.error(`fork: ${outcome.why} — the durable wake stays at ${wakePath}`)
      process.exitCode = 1
      return
    }
    const { session, created } = findOrOpenSession({
      cwd: job.dir,
      host: { tool: job.spawner.tool, session_id: job.spawner.session_id },
    })
    const at = new Date().toISOString()
    job.consumed = { at, via: "fork", label: outcome.label, pane: outcome.pane }
    saveJob(job)
    appendEvent(job.sid, { actor: "levy", kind: "wake.consumed", jid: job.id, via: "fork", label: outcome.label })
    console.log(`fork: ${outcome.label} born at pane ${outcome.pane}${created ? " (levy session opened)" : ""}`)
    console.log(`session: ${job.spawner.tool}:${job.spawner.session_id} resumed from ${job.spawner.since}`)
    console.log(`wake: ${wake.message}`)
    console.log(`trace: ${eventsPath(session.id)}`)
    return
  }

  // register — the levy pane registry (ADR 0008's retired wake rung):
  // the wake ladder no longer consults this (2026-10-13 — spawn-time
  // pane capture replaced it); the record survives as AUDIT
  // bookkeeping, so a legitimately-live unbooked pane (your chat) is
  // not flagged a stray. Run from INSIDE the pane (HERDR_PANE_ID
  // names it); herdr must already detect an agent there.
  if (cmd === "register") {
    const args = process.argv.slice(3)
    const fromIdx = args.indexOf("--from")
    const fromVal = fromIdx !== -1 ? args[fromIdx + 1] : undefined
    const paneIdx = args.indexOf("--pane")
    const pane = paneIdx !== -1 ? args[paneIdx + 1] : process.env.HERDR_PANE_ID
    if (!fromVal || !/^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$/.test(fromVal)) {
      console.error("register: --from wants <tool>:<session-id>, e.g. --from opencode:ses_01abc")
      process.exitCode = 2
      return
    }
    if (!pane) {
      console.error("register: run me from INSIDE the herdr pane that holds your chat (HERDR_PANE_ID is not set)")
      console.error("register: or pass --pane <pane-id> explicitly")
      process.exitCode = 2
      return
    }
    const i = fromVal.indexOf(":")
    const tool = fromVal.slice(0, i)
    const session_id = fromVal.slice(i + 1)
    // the pane must hold a live detected agent of the booked kind —
    // registration binds a conversation, not an empty shell
    let agent = null
    try {
      const list = JSON.parse(execFileSync("herdr", ["agent", "list"], { encoding: "utf8", timeout: 30_000 }))
      agent = (list?.result?.agents ?? []).find((a) => a.pane_id === pane) ?? null
    } catch { /* herdr down: the get below will say so */ }
    if (!agent) {
      console.error(`register: herdr detects no agent in pane ${pane} — open your chat there first (any supported kind)`)
      process.exitCode = 1
      return
    }
    if (agent.agent !== tool) {
      console.error(`register: pane ${pane} runs a '${agent.agent}' agent, but --from books '${tool}' — mismatched binding refused`)
      process.exitCode = 1
      return
    }
    registerLevyPane({ session_id, tool, pane, cwd: agent.cwd, at: new Date().toISOString() })
    console.log(`register: session ${tool}:${session_id} ↔ pane ${pane}`)
    console.log(`register: audit now exempts this pane as a levy chat — the wake ladder itself uses spawn-time pane capture (--from/--pane), not this registry`)
    return
  }

  // plugin install|uninstall|status — the in-band wake channel's reader half
  // (ADR 0008). The plugin file is OWNED by this checkout; the install
  // is a symlink, so git pulls update it — no second source to drift.
  if (cmd === "plugin") {
    const sub = process.argv[3]
    const src = realpathSync(join(fileURLToPath(new URL(".", import.meta.url)), "..", "plugin", "opencode-wake.js"))
    const dst = join(homedir(), ".config", "opencode", "plugins", "agentic-wake.js")
    if (sub === "install") {
      if (!existsSync(src)) {
        console.error(`plugin: source missing: ${src}`)
        process.exitCode = 1
        return
      }
      mkdirSync(join(homedir(), ".config", "opencode", "plugins"), { recursive: true })
      let how = "symlink"
      try {
        rmSync(dst, { force: true })
        symlinkSync(src, dst)
      } catch {
        // a copy still works — it just needs re-install to update
        copyFileSync(src, dst)
        how = "copy"
      }
      console.log(`plugin: installed ${how === "symlink" ? "(symlink — git pull updates it)" : "(copy — re-run to update)"}`)
      console.log(`plugin: ${dst}`)
      console.log(`plugin: restart opencode for it to load; wakes then land in-band (spool at ${join(homeRoot(), "wake-spool")})`)
      return
    }
    if (sub === "uninstall") {
      rmSync(dst, { force: true })
      console.log(`plugin: uninstalled (${dst}) — the spool rung goes dormant until you reinstall`)
      return
    }
    if (sub === "status") {
      const linked = existsSync(dst)
      console.log(`plugin: ${linked ? `installed at ${dst}` : "not installed — run: whl plugin install"}`)
      if (linked) {
        try {
          const real = realpathSync(dst)
          const same = real === src
          console.log(`plugin: resolves to ${real}${same ? "" : "  (NOT this checkout — stale copy?)"}`)
        } catch {
          console.log("plugin: DANGLING — the symlink target is gone; re-run: whl plugin install")
        }
      }
      return
    }
    console.error("usage: whitehartlane plugin install|status")
    process.exitCode = 2
    return
  }

  // fail — the test button: mark a finished Job failed on demand and
  // fire the wake ladder, so the delivery path can be exercised and
  // debugged without staging a real failing run. The printed rung
  // trace is the ladder's own debug log (also stamped into
  // job.woke.rungs, the session trail, and the job's orchestrator.log).
  if (cmd === "fail") {
    const args = process.argv.slice(3)
    const jid = process.argv[3]
    const rIdx = args.indexOf("--reason")
    const reason = rIdx !== -1 && args[rIdx + 1] !== undefined ? args[rIdx + 1] : "fail-button pressed"
    const again = args.includes("--again")
    const job = jobs.find((j) => j.id === jid)
    if (!jid || jid.startsWith("--") || !job) {
      console.error(`fail: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (job.state === "running") {
      console.error(`fail: ${job.id} is running — abort or pause it first (abort owns live jobs)`)
      process.exitCode = 2
      return
    }
    if (job.woke && !again) {
      console.error(`fail: ${job.id} already woke at ${job.woke.at} (delivery ${job.woke.delivery ?? "?"}) — pass --again to re-fire the ladder for testing`)
      process.exitCode = 2
      return
    }
    const failed = failJob(job, reason, { again })
    if (!failed) {
      console.error(`fail: ${job.id} declined — run: whitehartlane events ${job.sid}`)
      process.exitCode = 1
      return
    }
    console.log(`fail: ${failed.id} marked failed (fail-button: ${reason}) — report at ${failed.receipt?.report}`)
    if (!failed.woke) {
      console.log(`fail: no spawner on record — nothing to wake`)
      return
    }
    console.log(`fail: wake delivery=${failed.woke.delivery ?? "?"}${failed.woke.to ? ` to ${failed.woke.to}` : ""}`)
    for (const r of failed.woke.rungs ?? []) {
      console.log(`  rung ${r.rung}: ${r.ok ? "ok" : "no"}${r.why ? ` — ${r.why}` : ""}`)
    }
    return
  }

  if (cmd === "abort") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`abort: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (job.state === "retired") {
      console.error(`abort: ${job.id} is already retired`)
      process.exitCode = 2
      return
    }
    if (job.state === "running" && pidAlive(job.pid)) {
      // kill semantics (ADR 5): SIGKILL — the orchestrator cannot book,
      // so the CLI books the abort and retires the panes itself.
      // Unfinished units stay open; their booked sessions survive for
      // a later continue. (SIGTERM is pause, not abort.)
      try {
        process.kill(job.pid, "SIGKILL")
      } catch (err) {
        console.error(`abort: could not kill pid ${job.pid} (${err.message}) — declining on record`)
      }
      const live = shepStatus()
      for (const pane of job.panes.filter((p) => p.died === undefined)) {
        try {
          execFileSync("shep", ["retire", pane.label], { timeout: 30_000 })
        } catch {}
        killPane(job, pane.label)
      }
      // process-level guarantee (2026-10-17 ghost-worker incident): herdr's
      // registry can forget a pane while its agent process lives on in the
      // job's run dir, still executing its brief (recreating containers,
      // re-booking jobs). Anything holding this job's dir dies with the job.
      try {
        execFileSync("pkill", ["-9", "-f", job.dir], { timeout: 10_000 })
      } catch {}
      abortJob(job, `killed pid ${job.pid}`, 0, "levy")
      console.log(`aborted ${job.id} (killed orchestrator; sessions kept — continue resumes) — ${job.dir}`)
      return
    }
    const live = shepStatus()
    abortJob(job, "declined by user", livePanesOf(job, live).length, "levy")
    console.log(`aborted ${job.id} (declined) — ${job.dir}`)
    return
  }

  console.error("usage: whitehartlane run <folder> | jobs | events [sid] | audit | sweep | pause <jid> [--wait 2m] | abort <jid> | continue <jid> | fork <jid> | register --from <tool>:<sid> | plugin install|uninstall|status | promote <jid>")
  process.exitCode = 2
}

await main()
