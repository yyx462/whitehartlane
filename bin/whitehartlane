#!/usr/bin/env -S node --experimental-strip-types
// whitehartlane run <folder> | jobs | events | audit | sweep | pause | abort |
// fail | continue | regrade | fork | register | promote | plugin install|uninstall|status — the start door is run. It reads workflow.toml and
// starts that workflow's engine. The rest read and finish the OS disk
// (~/.local/share/whitehartlane). jobs lists every Job record with its state
// and receipt; audit diffs live shep panes against booked panes (every
// pane is born booked — a live pane no Job admits is a violation); sweep
// parks running Jobs whose orchestrator died without a graceful stop in
// the ask-first queue — orphaned, not aborted, never auto-resurrected;
// pause SIGTERMs a live orchestrator, which drains to its boundary and
// books paused (ADR 5); abort kills immediately (SIGKILL — sessions stay
// booked for a later continue); continue rebirths a paused/aborted/
// orphaned Job from its booked session pointers (the old relaunch,
// absorbed — M3: no cap, a soft continued ×N counter); fork delivers a
// booked wake into a reborn levy pane (ADR 0006 §3 — the spawner seed
// resumed from the checkpoint, the wake as the first prompt).
import { execFileSync, spawnSync } from "node:child_process"
import { copyFileSync, existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, symlinkSync, writeFileSync } from "node:fs"
import { homedir, tmpdir } from "node:os"
import { join, dirname } from "node:path"
import { fileURLToPath } from "node:url"
/** @typedef {import("../src/store.ts").JobRecord} JobRecord */
import { prepareRun, spawnerFromArgs } from "../src/doors/run.ts"
import { prepareReview, reviewReceipt } from "../src/doors/review.ts"
import { gateReceipt, runGate } from "../src/doors/review-gate.ts"
import { refreshWait } from "../src/doors/refresh.ts"
import { defaultRunner, jsonAt } from "../src/doors/runners.ts"
import { forkLevy } from "../src/adapters/fork.ts"
import { regradeJob } from "../src/doors/resume.ts"
import { allLevyPanes, levyPaneByPane, registerLevyPane } from "../src/adapters/levy-pane.ts"
import { rebirthRunner, runnerDoor, spawnRunner } from "../src/adapters/levy.ts"
import { readState } from "../src/core/state.ts"
import { seedSessionFile } from "../src/adapters/transcripts.ts"
import { admitFork } from "../src/jev/policy.ts"
import {
  abortJob,
  appendEvent,
  eventsPath,
  failJob,
  findOrOpenSession,
  findSessionBySpur,
  homeRoot,
  killPane,
  leaseExpired,
  listJobs,
  bookingStale,
  loadJob,
  normalizeSpur,

  orphanJob,
  projectJob,
  readAllEvents,
  pidAlive,
  readEvents,
  saveJob,
  wakeAudit,
} from "../src/adapters/store.ts"
import { contentHashOf, duplicateStageIds, relSourceOf, scopeRootOf, spurIdOf, validateSpurId } from "../src/doors/project.ts"
import { loadManifest, probeHooks } from "../src/doors/hooks.ts"
import { jobTracePath, renderTraceTable } from "../src/adapters/trace.ts"
import { formatGate, markPromoted, promoteFindings, submitPr, worktreeHasWork } from "../src/doors/promote.ts"
import { resolve } from "node:path"

// "90s", "2m", "1h", "5000" (ms) — the pause --wait one-shot ceiling.
function parseDuration(raw) {
  const m = /^(\d+)(ms|s|m|h)?$/.exec(String(raw ?? ""))
  if (!m) return null
  const scale = { ms: 1, s: 1000, m: 60_000, h: 3_600_000, "": 1 }[m[2] ?? ""] ?? 1
  const ms = Number(m[1]) * scale
  return Number.isFinite(ms) && ms > 0 ? ms : null
}

/** @typedef {{ label: string, pane: string }} LivePane */

/** @returns {LivePane[]} */
function shepStatus() {
  try {
    const out = execFileSync("shep", ["status"], { encoding: "utf8", timeout: 30_000 })
    return out
      .split("\n")
      .map((line) => line.trim())
      .filter((line) => line && !line.startsWith("name ") && !line.startsWith("status:"))
      .map((line) => {
        const [label, pane] = line.split(/\s+/)
        return { label, pane }
      })
      .filter((p) => p.label && p.pane)
  } catch {
    return []
  }
}

// the runner seam (src/runners.ts): one place the external CLIs are
// dialed — shared with the Rail, swappable when the substrate changes
const herdrAt = defaultRunner("herdr")

/** @param {JobRecord} job */
function unitsOf(job) {
  try {
    // the unit ledger (OPTIMUM §4) — one fold, both spellings: a
    // pre-consolidation dir still wins its own state.json read
    if (!existsSync(join(job.dir, "checkpoints.jsonl")) && !existsSync(join(job.dir, "state.json"))) {
      return null
    }
    const settled = readState(job.dir)
    return { done: settled.done.length, failed: settled.failed.length }
  } catch {
    return null
  }
}

/** @param {JobRecord[]} jobs */
function fmtJobs(jobs) {
  const rows = jobs.map((job) => {
    const units = unitsOf(job)
    const born = job.panes.length
    const dead = job.panes.filter((p) => p.died).length
    const outcome = job.receipt
      ? `receipt ${job.receipt.panesRemaining} left, ${job.receipt.unitsDone ?? "?"} done`
      : job.abort
        ? `aborted: ${job.abort.reason} — continue?`
        : job.orphan
          ? `orphaned: ${job.orphan.reason} — continue?`
          : job.pause
            ? `paused: ${job.pause.reason} — continue?`
            : "in flight"
    return [
      job.id.padEnd(9),
      job.state.padEnd(8),
      `${job.workflow} by ${job.stoodUpBy}`.padEnd(22),
      units ? `u ${units.done}d/${units.failed}f` : "u -",
      `p ${dead}/${born}`,
      `${job.continues ? `×${job.continues} ` : ""}${outcome}`,
      job.dir,
    ].join("  ")
  })
  return [`job      state    stood up by           units    panes   outcome                     dir`, ...rows].join("\n")
}

/** @param {JobRecord} job @param {LivePane[]} live */
function livePanesOf(job, live) {
  const labels = new Set(job.panes.map((p) => p.label))
  return live.filter((p) => labels.has(p.label))
}

async function main() {
  const cmd = process.argv[2]
  const jobs = listJobs()

  // renewal-by-presence (ADR 0008): living in a registered levy pane
  // and using the door IS the heartbeat — touch the registration.
  if (process.env.HERDR_PANE_ID) {
    const reg = levyPaneByPane(process.env.HERDR_PANE_ID)
    if (reg) registerLevyPane({ ...reg, at: new Date().toISOString() })
  }

  // help — the stage manual's front door (full manual: docs/STAGES.md)
  if (cmd === "help" || cmd === "--help") {
    const topic = process.argv[3]
    if (topic && topic !== "stages") {
      console.error(`help: unknown topic '${topic}' — try: whitehartlane help stages`)
      process.exitCode = 2
      return
    }
    console.log(`whitehartlane — the door

  run <folder> [--from <tool>:<sid>]   commission a spur (the levy walks away)
  review <repo> [--base <ref>] [--head <ref>] [--trace-dir <dir>]
                                       materialize + levy the adversarial
                                       pre-merge review (PR→merge gap:
                                       proven findings block, accept
                                       merges, reject divides feedback)
  jobs                                 the board
  events | audit | sweep | promote     observation and care
  pause | continue | regrade | fork    the resume ladder
  help [stages]                        this text / the stage cheat-sheet

stage programs ([[stage]] chains) — full manual in docs/STAGES.md:

  topology   workforce              the one-line rule
  ─────────────────────────────────────────────────────────────
  solo       one briefed worker     the simple link
  fan-out    N interchangeable      parallel shards/attempts; slots cap
  coworker   roles that TALK        hosted at stations/<id>/; its check
                                   is the STOP CEREMONY (below)
  gate       nobody — the rail      run executes once; verify.sh lives here
  lab        one ACTOR, observed    hosted at stations/<id>/; signal/end
                                   detectors observe

  brief taxonomy: stage brief (one mind) · roster brief (per worker)
  starting brief (a ROLE — the initiates member) · preamble (the
  roster's shared part; effective brief = preamble + own entry)

  verdict verbs: check = judge (stage's own hook) · run = act (rail
  does it) · grade = bind (task verifier, last unit stage by default)
  signal/end = observe (lab detectors)

  verdict timing — a judge that can reach its author MUST: stage
  checks fire while the workforce lives (solo/fan-out at each
  worker's finish; coworker at the exchange's STOP — red hands the
  check's stderr to the stop's author for ONE revise round, then an
  honest fail; a hosted station's stop verdict is its stage check
  ONLY, never the parent's [hooks] verdict). A gate's run is the one
  deliberately COLD verdict — it fires at the frontier, after the
  chain settles: use it to act (install, promote) and for the final
  verify, never to judge a workforce you wanted fixable.

  model pins: a mind's pin = its nearest declaration —
  unit.model → stage.model → [workflow] model (fresh per stage)

  dry-run: worker_kind = "mock" — no agent born; checks/gates/grades
  still fire; a whole program rehearses in seconds, zero tokens`)
    return
  }

  if (cmd === "run") {
    const args = process.argv.slice(3)
    const verbose = args.includes("--verbose")
    // ADR 0006: --from <tool>:<session-id> books the spawning levy
    // as the checkpoint — the Job will wake it once at the end. Inside
    // herdr the pane rides along (HERDR_PANE_ID or --pane): the wake's
    // parent-pane rung prompts it in-band when the Job finishes.
    const fromIdx = args.indexOf("--from")
    const spawner = spawnerFromArgs(args)
    if (fromIdx !== -1 && !spawner) {
      console.error("run: --from wants <tool>:<session-id>, e.g. --from opencode:ses_01abc")
      process.exitCode = 2
      return
    }
    // A Job nobody hears finishing is an information gap (j-b6067c:
    // levied without --from, its end reached nobody). Book a levy by
    // default; the humanless path is an explicit choice, not a
    // forgotten flag.
    const unattended = args.includes("--unattended")
    if (!spawner && !unattended) {
      console.error("run: no levy booked — pass --from <tool>:<session-id> (the Job wakes it exactly once at the end),")
      console.error("run: or --unattended if truly nobody waits. The durable receipt lands either way; the wake is the gap you are closing.")
      process.exitCode = 2
      return
    }
    const paneIdx = args.indexOf("--pane")
    const folder = args.find(
      (arg, i) =>
        !arg.startsWith("-") &&
        !(fromIdx !== -1 && i === fromIdx + 1) &&
        !(paneIdx !== -1 && i === paneIdx + 1),
    )
    if (!folder) {
      console.error("usage: whitehartlane run <folder> [--from <tool>:<session-id>] [--pane <pane-id>] [--verbose]")
      process.exitCode = 2
      return
    }
    const ready = prepareRun(folder)
    if (!ready.ok) {
      console.error(`run: ${ready.why}`)
      process.exitCode = ready.code
      return
    }
    if (spawner) {
      ready.job.spawner = spawner
      saveJob(ready.job)
    }
    const spawned = spawnRunner(ready.job, import.meta.dirname, {
      extraEnv: verbose ? { AGENTIC_OS_VERBOSE: "1" } : undefined,
    })
    if (!spawned.ok) {
      abortJob(ready.job, spawned.why, 0, "cli")
      console.error(`run: ${spawned.why}`)
      process.exitCode = 1
      return
    }
    console.log(`job: ${ready.job.id}`)
    console.log(`workflow: ${ready.kind}`)
    if (ready.job.spur ?? ready.job.dag) {
      const d = normalizeSpur(ready.job.spur ?? ready.job.dag)
      if (d) {
        const labels = Object.entries(d.labels ?? {}).map(([k, v]) => ` ${k}:${v}`).join("")
        console.log(`spur: ${d.project}/${d.spur_id} version ${d.content_hash}${labels}`)
      }
    }
    for (const w of ready.warnings) console.error(`warning: ${w}`)
    console.log(`log: ${ready.log}`)
    console.log(`trace: ${ready.trace}`)
    return
  }

  if (cmd === "review") {
    const args = process.argv.slice(3)
    // --help is a first-class verb here (the r-250 receipt: `whl review
    // --help` treated the flag as a repo path and died with "not a git
    // repository" — a CLI that cannot say its own spell is not a CLI)
    if (args.includes("--help") || args.includes("-h")) {
      console.log(`whitehartlane review — the adversarial pre-merge rail

  review <repo> --base <ref> --head <ref> --model <provider/model>
        [--title <s>] [--author <s>] [--merge-cmd <cmd>] [--trace-dir <dir>]
        [--body-file <f>] [--out <dir>] [--template <dir>]
        [--from <tool>:<sid> | --unattended]

  what it does
    materializes templates/pr-review for BASE..HEAD of <repo> and
    (with --from/--unattended) levies it: intake gate → 4 lenses
    (principles / tests / momentum / questions, temperature-spread) →
    prove gate (a finding blocks ONLY with a repro failing 2× on HEAD
    and clean on base) → responsibility divide → cold merge gate
    (accept merges — base drift refuses; reject divides feedback per
    responsible worker; verdict at data/review/verdict.json).

  the spell (from an agent session — tracked background shell):
    whl review <repo> --base master --head <branch> \\
      --out <dir> --title "<pr title>" --model <provider/model> \\
      --merge-cmd "<cmd>" --unattended

  hard rules
    - --model is REQUIRED as provider/model when the template's
      temperature pins have nothing to ride (bare ids are refused)
    - docs-only diffs skip at the door (receipt printed, exit 0)
    - a dead/stalled unit is NOT a dead review: re-levy the SAME
      program dir (whl run <dir> --unattended) — the settled fold
      spares done units; never materialize a fresh program to retry.
      If the door refuses because the killed run's Job still reads
      running (a SIGKILL leaves it that way): run "whl sweep" to
      orphan the dead run, then re-levy
    - reviewers never write the repo; tests are adopted by the fix
      commit (verdict.json adopt[] lists them)

  economics (tokens, duplicates, speed): templates/pr-review/ECONOMICS.md
  trace past runs: node scripts/review-trace.mjs`)
      return
    }
    const val = (name) => {
      const i = args.indexOf(`--${name}`)
      return i !== -1 ? args[i + 1] : undefined
    }
    const flagVals = new Set(["--base", "--head", "--title", "--author", "--merge-cmd", "--trace-dir", "--body-file", "--out", "--template", "--from", "--model"])
    const positional = args.find((a, i) => i === 0 || (a && !a.startsWith("-") && !flagVals.has(args[i - 1])))
    const spawner = spawnerFromArgs(args)
    const unattended = args.includes("--unattended")
    const gateOnly = args.includes("--gate-only")
    if (!positional) {
      console.error("usage: whitehartlane review <repo> [--base <ref>] [--head <ref>] [--model <provider/model>] [--title <s>] [--author <s>]")
      console.error("                               [--merge-cmd <cmd>] [--trace-dir <dir>] [--body-file <f>] [--out <dir>] [--gate-only]")
      console.error("                               [--from <tool>:<sid> | --unattended]")
      process.exitCode = 2
      return
    }
    // the gate runs FIRST (review-gate.ts): facts → one `jev run`
    // (four noul, one per lens) → roster + dropout audit + ledger row.
    // Fail-safe: jev unreachable → every lens runs. WHL_GATE=off is
    // the kill-switch (legacy full-rail behavior).
    let gateRoster = undefined
    let gateAudit = false
    if (process.env.WHL_GATE !== "off") {
      const baseRef = val("base") ?? "master"
      const headRef = val("head") ?? "HEAD"
      try {
        const g = runGate(resolve(positional), baseRef, headRef)
        console.log(gateReceipt(g.features, g.decision))
        // a skip STANDS only when unaudited (gate-r1 momentum-2: the
        // ledger records the judgment; the ESCALATION still levies)
        if (g.decision.action === "skip" && !g.decision.audit) return // receipt + ledger row; nothing levied
        if (gateOnly) return // decided + ledger row; the caller levies
        gateAudit = g.decision.audit === true
        if (gateAudit && !val("model")) {
          console.log("review: dropout audit without --model — temperature pins dropped; the lenses run on the host default, untuned")
        }
        if (g.decision.action === "review" && g.decision.roster.length < 4) gateRoster = g.decision.roster
      } catch (err) {
        // the gate must never BLOCK a review (that would be a new
        // failure mode in front of the rail) — a broken gate reviews
        console.error(`gate: broken (${err instanceof Error ? err.message.split("\n")[0] : String(err)}) — fail-safe: full rail`)
      }
    }
    const ready = prepareReview(
      {
        repo: positional,
        base: val("base"),
        head: val("head"),
        title: val("title"),
        author: val("author"),
        mergeCmd: val("merge-cmd"),
        traceDir: val("trace-dir"),
        bodyFile: val("body-file"),
        out: val("out"),
        template: val("template"),
        model: val("model"),
        roster: gateRoster,
        // a dropout-audit levy reaches the RAIL (gate-r2 momentum-15):
        // the docs-only pre-flight skip must not eat the audit — the
        // audit exists to measure the skipped class
        auditLevy: gateAudit,
      },
      join(import.meta.dirname, "..", "templates"),
    )
    if (!ready.ok) {
      console.error(reviewReceipt(ready))
      process.exitCode = ready.code
      return
    }
    if (ready.skipped) {
      console.log(reviewReceipt(ready))
      return
    }
    // the door's own admission screens judge the materialized program
    // (grammar, deliverables, brief paths) — a broken template dies
    // here, before anything is booked
    const check = prepareRun(ready.dir, { check: true })
    if (!check.ok) {
      console.error(`review: the materialized program failed admission:\n${check.why}`)
      process.exitCode = 1
      return
    }
    if (!spawner && !unattended && !gateAudit) {
      console.log(reviewReceipt(ready))
      return
    }
    // a dropout AUDIT self-levies (gate-r2 momentum-15): an audit
    // nobody runs measures nothing — the whole point is the verdict
    const runReady = prepareRun(ready.dir)
    if (!runReady.ok) {
      console.error(`review: ${runReady.why}`)
      process.exitCode = runReady.code
      return
    }
    if (spawner) {
      runReady.job.spawner = spawner
      saveJob(runReady.job)
    }
    const spawned = spawnRunner(runReady.job, import.meta.dirname)
    if (!spawned.ok) {
      abortJob(runReady.job, spawned.why, 0, "cli")
      console.error(`review: ${spawned.why}`)
      process.exitCode = 1
      return
    }
    console.log(`job: ${runReady.job.id}`)
    console.log(`workflow: ${runReady.kind}`)
    console.log(`verdict: will land at ${join(ready.dir, "data", "review", "verdict.json")} (the staged run dir carries it)`)
    console.log(`log: ${runReady.log}`)
    console.log(`trace: ${runReady.trace}`)
    return
  }

  if (cmd === "jobs" || !cmd) {
    if (jobs.length === 0) {
      console.log("no Jobs on the OS disk")
      return
    }
    console.log(fmtJobs(jobs))
    return
  }

  if (cmd === "events") {
    // --job <jid>: the per-job TSV trace, rendered as the fixed table —
    // `column -t -s$'\t'` shape, straight from the file. The bare form
    // stays the JSONL fold dump (the internal trace).
    // --job <jid> --rebuild: the projection recovery the docs promise —
    // the Job record is REBUILT from the trace and saved over a
    // corrupted/mangled job.json (#201 row 9: advertised, never wired).
    const jobFlag = process.argv.indexOf("--job")
    if (jobFlag !== -1 && process.argv[jobFlag + 1]) {
      const jid = process.argv[jobFlag + 1]
      const owner = jobs.find((j) => j.id === jid)
      if (!owner) {
        console.error(`no job ${jid} on the OS disk`)
        process.exit(1)
      }
      if (process.argv.includes("--rebuild")) {
        const rebuilt = projectJob(owner.sid, jid)
        if (!rebuilt) {
          console.error(`rebuild: the trace holds no job.born for ${jid} — nothing to project`)
          process.exit(1)
        }
        saveJob(rebuilt)
        console.log(`rebuild: ${jid} projected from ${readEvents(owner.sid).filter((e) => e.jid === jid).length} trace event(s) — state=${rebuilt.state}, panes=${rebuilt.panes.length}, record saved`)
        return
      }
      console.log(renderTraceTable(jobTracePath(owner.sid, jid)))
      return
    }
    const sid = process.argv[3]
    const streams = sid ? [{ sid, events: readEvents(sid) }] : readAllEvents()
    let total = 0
    for (const { sid: s, events } of streams) {
      if (events.length === 0) continue
      console.log(`== session ${s} (${events.length} events)`)
      for (const e of events) console.log(JSON.stringify(e))
      total += events.length
    }
    console.log(`events: ${total} across ${streams.filter((x) => x.events.length).length} session(s)`)
    return
  }

  if (cmd === "validate") {
    // The dry-run door: everything run would check about a program, no
    // job booked, nothing run. CI-shaped by design — exit 0 is the
    // only silence.
    const folder = process.argv[3]
    if (!folder) {
      console.error("usage: whitehartlane validate <program-folder>")
      process.exit(2)
    }
    const dir = resolve(folder)
    const problems = []
    const notes = []
    if (!existsSync(dir)) problems.push(`no such folder: ${dir}`)
    if (!problems.length && !existsSync(join(dir, "workflow.toml"))) {
      problems.push("no workflow.toml — a program is workflow.toml with [[stage]] entries (ADR 0014)")
    }
    if (!problems.length) {
      let spurId = ""
      try {
        const manifest = loadManifest(dir)
        const wf = manifest.workflow
        const spur = spurIdOf({
          spurId: typeof wf.spur_id === "string" ? wf.spur_id : undefined,
          name: String(wf.name ?? ""),
          toml: readFileSync(join(dir, "workflow.toml"), "utf8"),
        })
        spurId = spur.spurId
        if (spur.derived) notes.push(`spur_id derived from content (${spur.spurId}) — define workflow.spur_id to group runs`)
        else {
          const bad = validateSpurId(spur.spurId)
          if (bad) problems.push(bad)
          else notes.push(`spur_id ${spur.spurId}`)
        }
      } catch (err) {
        problems.push(err instanceof Error ? err.message : String(err))
      }
      const dupStages = duplicateStageIds(dir)
      if (dupStages.length > 0) problems.push(`duplicate stage id(s): ${dupStages.join(", ")}`)
      try {
        const refusals = probeHooks(dir, loadManifest(dir))
        for (const r of refusals) problems.push(`hook probe: ${r}`)
      } catch (err) {
        problems.push(err instanceof Error ? err.message : String(err))
      }
      const scopeRoot = scopeRootOf(dir)
      notes.push(`scope ${scopeRoot}`)
      notes.push(`rel_source ${relSourceOf(dir, scopeRoot)}`)
      notes.push(`content_hash ${contentHashOf(dir)}`)
      if (spurId) {
        const existing = findSessionBySpur(scopeRoot, spurId)
        if (existing) notes.push(`lineage session ${existing.id} (rel_source ${existing.spur_key?.rel_source})`)
      }
    }
    for (const n of notes) console.log(`ok   ${n}`)
    for (const p of [...new Set(problems)]) console.error(`REFUSED ${p}`)
    if (problems.length) process.exit(1)
    return
  }

  if (cmd === "doctor") {
    // The install's one-shot health check: door rev, runner door,
    // orchestrator reachability, the OS disk, lease debt, and the
    // audit's own findings — each check says what it proves and how
    // to fix it when red. Exit 0 iff everything green.
    const checks = []
    const say = (name, ok, says) => {
      checks.push({ name, ok, says })
      console.log(`${ok ? "ok  " : "RED "} ${name} — ${says}`)
    }
    say("door", true, `node ${process.version} (rev reads per-run: job.door.rev)`)
    const runner = runnerDoor(resolve(dirname(fileURLToPath(import.meta.url))))
    const runnerOk = existsSync(runner)
    say("runner door", runnerOk, runnerOk ? runner : `missing at ${runner} — rebuild: npm run build`)
    // the runner door on a program-less dir must refuse CLEANLY — the
    // named fatal + rc=1 (it boots, refuses); a module crash exits
    // with a stack and no fatal line. The probe runs against an
    // ISOLATED OS home: a diagnostic must book nothing on the install
    // it is diagnosing (run #12's acceptance E2 counted two doctor
    // probes as phantom commissions — j-521c0e, j-6c8170).
    const probeDir = mkdtempSync(join(tmpdir(), "whl-doctor-probe-"))
    const probeHome = mkdtempSync(join(tmpdir(), "whl-doctor-home-"))
    const probe = spawnSync(process.execPath, ["--experimental-strip-types", runner, probeDir], {
      encoding: "utf8",
      timeout: 20_000,
      env: { ...process.env, AGENTIC_OS_HOME: probeHome, AGENTIC_OS_NOTIFY: "0" },
    })
    rmSync(probeDir, { recursive: true, force: true })
    rmSync(probeHome, { recursive: true, force: true })
    const cleanRefusal = `${probe.stdout ?? ""}${probe.stderr ?? ""}`.includes("fatal: no workflow.toml")
    say(
      "runner boots",
      cleanRefusal,
      cleanRefusal ? "refused a program-less dir by name (fatal: no workflow.toml)" : `probe rc=${probe.status} without the named refusal: ${(probe.stderr ?? "").split("\n")[0]}`,
    )
    const shep = spawnSync("shep", ["status"], { encoding: "utf8", timeout: 10_000 })
    say("shep panes", shep.status === 0, shep.status === 0 ? `${(shep.stdout.match(/^\s*\S+\s+\S+/gm) ?? []).length} pane row(s)` : `shep status rc=${shep.status} — is the multiplexer up?`)
    say("OS disk", jobs.length >= 0, `${jobs.length} job record(s) under ${process.env.AGENTIC_OS_HOME ?? "~/.local/share/whitehartlane"}`)
    // THE stale-booking oracle (store.ts bookingStale) — same answer
    // as the sweep and the booking probe (r18 principles-11)
    const leased = jobs.filter((j) => bookingStale(j, Date.now()))
    say("live jobs", leased.length === 0, leased.length === 0 ? "every running Job has a live orchestrator" : `${leased.length} running without a live pid — sweep parks them: whitehartlane sweep`)
    const gitOk = spawnSync("git", ["-C", process.cwd(), "rev-parse", "--is-inside-work-tree"], { encoding: "utf8" })
    say("git tree", gitOk.status === 0, gitOk.status === 0 ? process.cwd() : "not a git checkout (fine for installs, suspicious for dev)")
    const red = checks.filter((c) => !c.ok).length
    console.log(red === 0 ? `doctor: ${checks.length} checks green` : `doctor: ${red} red of ${checks.length}`)
    process.exitCode = red === 0 ? 0 : 1
    return
  }

  if (cmd === "audit") {
    const live = shepStatus()
    const admitted = new Set([
      ...jobs.flatMap((job) => job.panes.map((p) => p.label)),
      ...allLevyPanes().map((r) => r.pane),
    ])
    const bastards = live.filter((p) => !admitted.has(p.label))
    const stalled = jobs.filter((job) => bookingStale(job, Date.now()))
    console.log(`panes live in shep: ${live.length}; admitted by Jobs: ${live.length - bastards.length}`)
    for (const pane of bastards) {
      console.log(`UNADMITTED ${pane.label} (${pane.pane}) — no booked birth; retire it: shep retire ${pane.label}`)
    }
    for (const job of stalled) {
      console.log(`STALLED ${job.id} — orchestrator pid ${job.pid} is gone; run: whitehartlane sweep`)
    }
    // ADR 0010 — the doorbell is a last resort, never a silent one:
    // every wake that fell out of band (and was never consumed) is
    // named here, with the fork rung's diagnosis and the drain verb
    const outOfBand = wakeAudit(jobs)
    for (const row of outOfBand.slice(0, 10)) {
      console.log(`OUT-OF-BAND wake ${row.jid} (${row.task}) — ${row.delivery} at ${row.at}: ${row.why}; drain it: whitehartlane fork ${row.jid}`)
    }
    const dirty = bastards.length + stalled.length + outOfBand.length
    console.log(
      dirty === 0
        ? "audit: clean"
        : `audit: ${bastards.length} unadmitted, ${stalled.length} stalled, ${outOfBand.length} out-of-band wake(s)`,
    )
    process.exitCode = dirty === 0 ? 0 : 1
    return
  }

  if (cmd === "sweep") {
    const live = shepStatus()
    let swept = 0
    for (const job of jobs) {
      if (job.state !== "running") continue
      // Issue #123 — the sweep's oracle is the holder pid first; pure
      // lease expiry (a wedged-but-alive orchestrator) is opt-in via
      // AGENTIC_OS_LEASE_ENFORCE=1 until beat density is proven across
      // quiet fan-out waits. Timers grant the right to suspect; the
      // census decides.
      const pidGone = bookingStale(job, Date.now())
      const leaseGone =
        process.env.AGENTIC_OS_LEASE_ENFORCE === "1" && leaseExpired(job)
      if (!pidGone && !leaseGone) {
        if (leaseExpired(job)) {
          console.log(`${job.id} lease expired at ${job.lease?.expires} but pid ${job.pid} is alive — watched, not swept (AGENTIC_OS_LEASE_ENFORCE=1 to act)`)
        } else {
          console.log(`${job.id} running (pid ${job.pid}) — left alone`)
        }
        continue
      }
      // single-act: re-read the record — another sweep (or the
      // orchestrator's own epilogue) may have flipped the state since
      // this list was built; orphanJob no-ops on non-running either way
      const fresh = loadJob(job.sid, job.id) ?? job
      if (fresh.state !== "running") continue
      const orphans = livePanesOf(fresh, live)
      orphanJob(fresh, pidGone ? `orchestrator pid ${fresh.pid ?? "?"} gone` : `lease expired at ${fresh.lease?.expires}`, orphans.length)
      swept += 1
      console.log(`${fresh.id} orphaned (parked, ask-first) — ${fresh.dir}`)
      console.log(`  continue: whitehartlane continue ${fresh.id} | decline: whitehartlane abort ${fresh.id}`)
      if (orphans.length > 0) {
        console.log(`  straggler panes still live (continue retires them): ${orphans.map((p) => p.label).join(", ")}`)
      }
    }
    console.log(swept === 0 ? "sweep: nothing to finish" : `sweep: ${swept} Job(s) parked for a continue decision`)
    return
  }

  if (cmd === "promote") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`promote: no such Job '${jid ?? ""}'`)
      process.exitCode = 2
      return
    }
    const findings = promoteFindings({
      job,
      worktreeExists: job.worktree ? existsSync(job.worktree) : false,
      hasWork: job.worktree ? worktreeHasWork(job.worktree) : false,
    })
    if (findings.length > 0) {
      console.log(formatGate(job.id, findings))
      process.exitCode = 1
      return
    }
    const title = job.task.split("\n")[0].slice(0, 72)
    const body = [
      job.task,
      "",
      `Job ${job.id} retired ${job.receipt?.status}. Panes remaining ${job.receipt?.panesRemaining}.`,
      "Opened by whitehartlane promote. Not merged.",
    ].join("\n")
    let note = ""
    try {
      note = submitPr(job.worktree, title, body).split("\n").slice(-3).join(" ")
    } catch (err) {
      console.log(formatGate(job.id, [{ check: "pr", detail: err instanceof Error ? err.message.split("\n")[0] : String(err) }]))
      process.exitCode = 1
      return
    }
    markPromoted(job, note || "pr opened")
    console.log(formatGate(job.id, [], note || "opened"))
    return
  }

  // refresh: a person asked the running orchestrator to get out of the
  // way so the current door can take the job. Drain to paused, then
  // continue. Never automatic. A ceiling miss does not continue.
  if (cmd === "refresh") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`refresh: no such Job '${jid ?? ""}'`)
      process.exitCode = 2
      return
    }
    if (job.state !== "running" || !pidAlive(job.pid)) {
      console.error(`refresh: ${job.id} is ${job.state}${job.pid ? " (orchestrator not live)" : ""} — only a running Job refreshes. A parked one is continue.`)
      process.exitCode = 2
      return
    }
    const ceiling = 10 * 60_000
    writeFileSync(join(job.dir, "drain.deadline"), new Date(Date.now() + ceiling).toISOString())
    try {
      process.kill(job.pid, "SIGTERM")
    } catch (err) {
      console.error(`refresh: could not signal pid ${job.pid} (${err.message})`)
      process.exitCode = 1
      return
    }
    console.log(`refresh: draining ${job.id} (pid ${job.pid}) — continue follows only after it books paused`)
    const started = Date.now()
    let fresh = job
    for (;;) {
      fresh = loadJob(job.sid, job.id) ?? fresh
      const step = refreshWait(fresh.state, Date.now() - started, ceiling)
      if (step === "wait") {
        Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 500)
        continue
      }
      if (step === "timeout") {
        console.error(`refresh: drain did not park within ${ceiling}ms — not continued. Abort, then continue, if you want to force it.`)
        process.exitCode = 1
        return
      }
      if (step === "stopped") {
        console.error(`refresh: ${job.id} left the drain as ${fresh.state} — not continued`)
        process.exitCode = 1
        return
      }
      break
    }
    const reborn = rebirthRunner(fresh, import.meta.dirname)
    if (!reborn.ok) {
      console.error(`refresh: ${reborn.why}`)
      // a successor-conflict refusal is the one-writer veto speaking —
      // exit 2, the same code `whl continue` refuses with on this
      // exact store (r25 principles-22's repro pins the code)
      process.exitCode = /successor booking/.test(reborn.why) ? 2 : 1
      return
    }
    console.log(`refreshed ${fresh.id} (pid ${reborn.pid}, ×${fresh.continues ?? 1}) — new door, sessions resumed — log: ${join(fresh.dir, "orchestrator.log")}`)
    return
  }

  // pause (ADR 5): SIGTERM is the drain — the orchestrator stops
  // claiming, lets in-flight units finish, retires its panes, and
  // books paused. --wait is a one-shot drain-ceiling override (2m, 90s).
  if (cmd === "pause") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`pause: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (job.state !== "running" || !pidAlive(job.pid)) {
      console.error(`pause: ${job.id} is ${job.state}${job.pid ? " (orchestrator not live)" : ""} — only a running Job can pause`)
      process.exitCode = 2
      return
    }
    const waitIdx = process.argv.indexOf("--wait")
    if (waitIdx !== -1) {
      const ms = parseDuration(process.argv[waitIdx + 1])
      if (ms === null) {
        console.error("pause: --wait wants a duration like 2m or 90s")
        process.exitCode = 2
        return
      }
      writeFileSync(join(job.dir, "drain.deadline"), new Date(Date.now() + ms).toISOString())
    }
    try {
      process.kill(job.pid, "SIGTERM")
      console.log(`pause: signalled orchestrator pid ${job.pid} — ${job.id} drains to a boundary, then books paused`)
    } catch (err) {
      console.error(`pause: could not signal pid ${job.pid} (${err.message})`)
      process.exitCode = 1
    }
    return
  }

  // continue (ADR 5): the reborn verb — paused, aborted, and orphaned
  // all continue the same way. Stragglers retire first (a live pane
  // from the parked generation would double-write a unit dir), then
  // the orchestrator resumes unfinished units from booked session
  // pointers. Deliberate and typed; the counter warns, never blocks.
  // (Absorbs the old relaunch: same straggler-retire + respawn path,
  // no cap — M3.)
  if (cmd === "continue") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`continue: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (job.state !== "paused" && job.state !== "aborted" && job.state !== "orphaned") {
      console.error(`continue: ${job.id} is ${job.state}, not paused/aborted/orphaned`)
      process.exitCode = 2
      return
    }
    // r23 questions-5 / r25 principles-22 — the successor screen lives
    // at the SHARED rebirth ceremony (rebirthRunner, levy.ts), which
    // both revival verbs land on. The lineage session is the kinship
    // (every booking mints its own run dir — j.dir is never equal).
    // #201 row 8: an edited declaration must not continue in silence —
    // the booking carries the program's content hash; a source that
    // hashes differently now means the rebirth runs DIFFERENT program
    // bytes than the ones that produced the work so far. Say it, book
    // it on the trace, and let the commissioner decide.
    if (job.spur?.source && job.spur?.content_hash) {
      let changed = false
      try {
        changed = contentHashOf(job.spur.source) !== job.spur.content_hash
      } catch {
        /* the source vanished — the plain continue still works */
      }
      if (changed) {
        appendEvent(job.sid, {
          actor: "cli",
          kind: "program.changed",
          jid: job.id,
          why: "the program source changed since booking — this continue runs edited bytes",
        })
        console.log(`continue: NOTE — ${job.spur.source} changed since booking; this rebirth runs the EDITED program (the staged copy in the job dir is untouched)`)
      }
    }
    // one rebirth ceremony (straggler retire + fresh runner + booked
    // continue) — the same verb `refresh` lands on after its drain.
    const reborn = rebirthRunner(job, import.meta.dirname)
    if (!reborn.ok) {
      console.error(`continue: ${reborn.why}`)
      // a successor-conflict refusal is the one-writer veto speaking —
      // exit 2 (r24 momentum-12's repro pins the code on this store)
      process.exitCode = /successor booking/.test(reborn.why) ? 2 : 1
      return
    }
    console.log(`continued ${job.id} (pid ${reborn.pid}, ×${job.continues ?? 1}) — unfinished units resume from booked sessions — log: ${join(job.dir, "orchestrator.log")}`)
    return
  }

  // regrade (#144): the minimal-rerun resume for a TERMINAL job. Units
  // that failed at the GRADE stage (worker output on disk, verdict bad
  // or faulty) re-enter at exactly that card — the worker never runs
  // again; the levy fixes/blesses the hook first, then one verb turns
  // mislabeled stops into honest reports. Units without worker output
  // say so: they want a rerun (fresh booking), not a regrade.
  if (cmd === "regrade") {
    const jid = process.argv[3]
    if (!jid) {
      console.error("regrade: wants a job id — whitehartlane regrade j-xxxx")
      process.exitCode = 2
      return
    }
    const r = regradeJob(jid)
    if (!r.ok) {
      console.error(`regrade: ${r.why}`)
      process.exitCode = 1
      return
    }
    if (r.regraded.length === 0) {
      console.log(`regrade ${jid}: nothing failed — report stands (${r.report?.status ?? "none"})`)
      return
    }
    for (const row of r.regraded) {
      console.log(`regrade ${jid}: ${row.unit} → ${row.pass ? "PASS" : "FAIL"} (${row.row})`)
    }
    if (r.needsRerun.length > 0) {
      console.log(`regrade ${jid}: ${r.needsRerun.join(", ")} lack worker output — rerun (a fresh booking spares done units)`)
    }
    console.log(`regrade ${jid}: report ${r.report?.status} at ${r.dir ? join(r.dir, "report.json") : "(run dir)"}`)
    return
  }

  // fork (ADR 0006 §3): deliver a booked wake into a reborn levy pane.
  // The seed is the spawner pointer — the levy's host session resumed
  // from the spawn checkpoint — and the wake message is the pane's
  // first prompt. Booked on the levy's session trace (the pane belongs
  // to the levy, not to the spur's Job); the spur records consumption.
  if (cmd === "fork") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`fork: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (!job.spawner) {
      console.error(`fork: ${job.id} is unattended — no levy to fork`)
      process.exitCode = 2
      return
    }
    const wakePath = join(job.dir, "wake.json")
    if (!existsSync(wakePath)) {
      console.error(`fork: ${job.id} has no booked wake (state ${job.state}) — only a finished or parked spur wakes its levy`)
      process.exitCode = 2
      return
    }
    let wake
    try {
      wake = JSON.parse(readFileSync(wakePath, "utf8"))
    } catch (err) {
      console.error(`fork: wake.json unreadable (${err instanceof Error ? err.message : String(err)})`)
      process.exitCode = 1
      return
    }
    const seedFile = seedSessionFile(job.spawner)
    const admission = admitFork({
      seed: { ...job.spawner, ...(seedFile ? { session_file: seedFile } : {}) },
      fileExists: (p) => existsSync(p),
    })
    if (!admission.admit) {
      console.error(`fork: the seed does not resolve — ${admission.why}`)
      console.error(`fork: the durable wake stays at ${wakePath}`)
      process.exitCode = 1
      return
    }
    // the birth body is forkLevy's — the same ladder the rail's wake
    // uses (targeted placement beside the levy when its pane lives,
    // a workspace-scoped tab otherwise, courier reaper, receipt). The
    // verb adds only what a human at the door needs: prints + booking.
    const outcome = forkLevy(job, { message: wake.message })
    if (!outcome.ok) {
      console.error(`fork: ${outcome.why} — the durable wake stays at ${wakePath}`)
      process.exitCode = 1
      return
    }
    const { session, created } = findOrOpenSession({
      cwd: job.dir,
      host: { tool: job.spawner.tool, session_id: job.spawner.session_id },
    })
    const at = new Date().toISOString()
    job.consumed = { at, via: "fork", label: outcome.label, pane: outcome.pane }
    saveJob(job)
    appendEvent(job.sid, { actor: "levy", kind: "wake.consumed", jid: job.id, via: "fork", label: outcome.label })
    console.log(`fork: ${outcome.label} born at pane ${outcome.pane}${created ? " (levy session opened)" : ""}`)
    console.log(`session: ${job.spawner.tool}:${job.spawner.session_id} resumed from ${job.spawner.since}`)
    console.log(`wake: ${wake.message}`)
    console.log(`trace: ${eventsPath(session.id)}`)
    return
  }

  // register — the levy pane registry (ADR 0008's retired wake rung):
  // the wake ladder no longer consults this (2026-10-13 — spawn-time
  // pane capture replaced it); the record survives as AUDIT
  // bookkeeping, so a legitimately-live unbooked pane (your chat) is
  // not flagged a stray. Run from INSIDE the pane (HERDR_PANE_ID
  // names it); herdr must already detect an agent there.
  if (cmd === "register") {
    const args = process.argv.slice(3)
    const fromIdx = args.indexOf("--from")
    const fromVal = fromIdx !== -1 ? args[fromIdx + 1] : undefined
    const paneIdx = args.indexOf("--pane")
    const pane = paneIdx !== -1 ? args[paneIdx + 1] : process.env.HERDR_PANE_ID
    if (!fromVal || !/^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$/.test(fromVal)) {
      console.error("register: --from wants <tool>:<session-id>, e.g. --from opencode:ses_01abc")
      process.exitCode = 2
      return
    }
    if (!pane) {
      console.error("register: run me from INSIDE the herdr pane that holds your chat (HERDR_PANE_ID is not set)")
      console.error("register: or pass --pane <pane-id> explicitly")
      process.exitCode = 2
      return
    }
    const i = fromVal.indexOf(":")
    const tool = fromVal.slice(0, i)
    const session_id = fromVal.slice(i + 1)
    // the pane must hold a live detected agent of the booked kind —
    // registration binds a conversation, not an empty shell
    let agent = null
    try {
      const list = JSON.parse(execFileSync("herdr", ["agent", "list"], { encoding: "utf8", timeout: 30_000 }))
      agent = (list?.result?.agents ?? []).find((a) => a.pane_id === pane) ?? null
    } catch { /* herdr down: the get below will say so */ }
    if (!agent) {
      console.error(`register: herdr detects no agent in pane ${pane} — open your chat there first (any supported kind)`)
      process.exitCode = 1
      return
    }
    if (agent.agent !== tool) {
      console.error(`register: pane ${pane} runs a '${agent.agent}' agent, but --from books '${tool}' — mismatched binding refused`)
      process.exitCode = 1
      return
    }
    registerLevyPane({ session_id, tool, pane, cwd: agent.cwd, at: new Date().toISOString() })
    console.log(`register: session ${tool}:${session_id} ↔ pane ${pane}`)
    console.log(`register: audit now exempts this pane as a levy chat — the wake ladder itself uses spawn-time pane capture (--from/--pane), not this registry`)
    return
  }

  // plugin install|uninstall|status — the in-band wake channel's reader half
  // (ADR 0008). The plugin file is OWNED by this checkout; the install
  // is a symlink, so git pulls update it — no second source to drift.
  if (cmd === "plugin") {
    const sub = process.argv[3]
    const src = realpathSync(join(fileURLToPath(new URL(".", import.meta.url)), "..", "plugin", "opencode-wake.js"))
    const dst = join(homedir(), ".config", "opencode", "plugins", "agentic-wake.js")
    if (sub === "install") {
      if (!existsSync(src)) {
        console.error(`plugin: source missing: ${src}`)
        process.exitCode = 1
        return
      }
      mkdirSync(join(homedir(), ".config", "opencode", "plugins"), { recursive: true })
      let how = "symlink"
      try {
        rmSync(dst, { force: true })
        symlinkSync(src, dst)
      } catch {
        // a copy still works — it just needs re-install to update
        copyFileSync(src, dst)
        how = "copy"
      }
      console.log(`plugin: installed ${how === "symlink" ? "(symlink — git pull updates it)" : "(copy — re-run to update)"}`)
      console.log(`plugin: ${dst}`)
      console.log(`plugin: restart opencode for it to load; wakes then land in-band (spool at ${join(homeRoot(), "wake-spool")})`)
      return
    }
    if (sub === "uninstall") {
      rmSync(dst, { force: true })
      console.log(`plugin: uninstalled (${dst}) — the spool rung goes dormant until you reinstall`)
      return
    }
    if (sub === "status") {
      const linked = existsSync(dst)
      console.log(`plugin: ${linked ? `installed at ${dst}` : "not installed — run: whl plugin install"}`)
      if (linked) {
        try {
          const real = realpathSync(dst)
          const same = real === src
          console.log(`plugin: resolves to ${real}${same ? "" : "  (NOT this checkout — stale copy?)"}`)
        } catch {
          console.log("plugin: DANGLING — the symlink target is gone; re-run: whl plugin install")
        }
      }
      return
    }
    console.error("usage: whitehartlane plugin install|status")
    process.exitCode = 2
    return
  }

  // fail — the test button: mark a finished Job failed on demand and
  // fire the wake ladder, so the delivery path can be exercised and
  // debugged without staging a real failing run. The printed rung
  // trace is the ladder's own debug log (also stamped into
  // job.woke.rungs, the session trail, and the job's orchestrator.log).
  if (cmd === "fail") {
    const args = process.argv.slice(3)
    const jid = process.argv[3]
    const rIdx = args.indexOf("--reason")
    const reason = rIdx !== -1 && args[rIdx + 1] !== undefined ? args[rIdx + 1] : "fail-button pressed"
    const again = args.includes("--again")
    const job = jobs.find((j) => j.id === jid)
    if (!jid || jid.startsWith("--") || !job) {
      console.error(`fail: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (job.state === "running") {
      console.error(`fail: ${job.id} is running — abort or pause it first (abort owns live jobs)`)
      process.exitCode = 2
      return
    }
    if (job.woke && !again) {
      console.error(`fail: ${job.id} already woke at ${job.woke.at} (delivery ${job.woke.delivery ?? "?"}) — pass --again to re-fire the ladder for testing`)
      process.exitCode = 2
      return
    }
    const failed = failJob(job, reason, { again })
    if (!failed) {
      console.error(`fail: ${job.id} declined — run: whitehartlane events ${job.sid}`)
      process.exitCode = 1
      return
    }
    console.log(`fail: ${failed.id} marked failed (fail-button: ${reason}) — report at ${failed.receipt?.report}`)
    if (!failed.woke) {
      console.log(`fail: no spawner on record — nothing to wake`)
      return
    }
    console.log(`fail: wake delivery=${failed.woke.delivery ?? "?"}${failed.woke.to ? ` to ${failed.woke.to}` : ""}`)
    for (const r of failed.woke.rungs ?? []) {
      console.log(`  rung ${r.rung}: ${r.ok ? "ok" : "no"}${r.why ? ` — ${r.why}` : ""}`)
    }
    return
  }

  if (cmd === "abort") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`abort: no such Job '${jid ?? ""}' — run: whitehartlane jobs`)
      process.exitCode = 2
      return
    }
    if (job.state === "retired") {
      console.error(`abort: ${job.id} is already retired`)
      process.exitCode = 2
      return
    }
    if (job.state === "running" && pidAlive(job.pid)) {
      // kill semantics (ADR 5): SIGKILL — the orchestrator cannot book,
      // so the CLI books the abort and retires the panes itself.
      // Unfinished units stay open; their booked sessions survive for
      // a later continue. (SIGTERM is pause, not abort.)
      try {
        process.kill(job.pid, "SIGKILL")
      } catch (err) {
        console.error(`abort: could not kill pid ${job.pid} (${err.message}) — declining on record`)
      }
      const live = shepStatus()
      for (const pane of job.panes.filter((p) => p.died === undefined)) {
        try {
          execFileSync("shep", ["retire", pane.label], { timeout: 30_000 })
        } catch {}
        killPane(job, pane.label)
      }
      // process-level guarantee (2026-10-17 ghost-worker incident): herdr's
      // registry can forget a pane while its agent process lives on in the
      // job's run dir, still executing its brief (recreating containers,
      // re-booking jobs). Anything holding this job's dir dies with the job.
      try {
        execFileSync("pkill", ["-9", "-f", job.dir], { timeout: 10_000 })
      } catch {}
      abortJob(job, `killed pid ${job.pid}`, 0, "levy")
      console.log(`aborted ${job.id} (killed orchestrator; sessions kept — continue resumes) — ${job.dir}`)
      return
    }
    const live = shepStatus()
    abortJob(job, "declined by user", livePanesOf(job, live).length, "levy")
    console.log(`aborted ${job.id} (declined) — ${job.dir}`)
    return
  }

  console.error("usage: whitehartlane run <folder> | jobs | events [sid] | audit | sweep | pause <jid> [--wait 2m] | abort <jid> | continue <jid> | fork <jid> | register --from <tool>:<sid> | plugin install|uninstall|status | promote <jid>")
  process.exitCode = 2
}

await main()
