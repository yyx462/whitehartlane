#!/usr/bin/env -S node --experimental-strip-types
// agentic-os jobs | events | audit | sweep | relaunch | abort — read
// and settle the OS disk (~/.local/share/agentic-os). jobs lists every
// Job record with its state and receipt; audit diffs live shep panes
// against admitted panes (the only door is JEV — a live pane no Job
// admits is a violation); sweep parks running Jobs whose orchestrator
// died without a graceful stop in the ask-first relaunch queue —
// orphaned, not aborted, never auto-resurrected; relaunch re-runs one
// from its run dir (user-decided, capped at 2 tries per Job); abort
// declines (or SIGTERMs a live orchestrator, which aborts itself).
import { execFileSync, spawn } from "node:child_process"
import { existsSync, openSync, readFileSync } from "node:fs"
import { join } from "node:path"
/** @typedef {import("../src/store.ts").JobRecord} JobRecord */
import {
  abortJob,
  killPane,
  listJobs,
  orphanJob,
  readAllEvents,
  readEvents,
  relaunchJob,
} from "../src/store.ts"

const RELAUNCH_CAP = 2

/** @typedef {{ label: string, pane: string }} LivePane */

/** @returns {LivePane[]} */
function shepStatus() {
  try {
    const out = execFileSync("shep", ["status"], { encoding: "utf8", timeout: 30_000 })
    return out
      .split("\n")
      .map((line) => line.trim())
      .filter((line) => line && !line.startsWith("name ") && !line.startsWith("status:"))
      .map((line) => {
        const [label, pane] = line.split(/\s+/)
        return { label, pane }
      })
      .filter((p) => p.label && p.pane)
  } catch {
    return []
  }
}

/** @param {number | undefined} pid */
function pidAlive(pid) {
  if (!pid) return false
  try {
    process.kill(pid, 0)
    return true
  } catch (err) {
    return err?.code === "EPERM"
  }
}

/** @param {JobRecord} job */
function unitsOf(job) {
  try {
    const state = JSON.parse(readFileSync(join(job.dir, "state.json"), "utf8"))
    return { done: state.done?.length ?? 0, failed: state.failed?.length ?? 0 }
  } catch {
    return null
  }
}

/** @param {JobRecord[]} jobs */
function fmtJobs(jobs) {
  const rows = jobs.map((job) => {
    const units = unitsOf(job)
    const born = job.panes.length
    const dead = job.panes.filter((p) => p.died).length
    const outcome = job.receipt
      ? `receipt ${job.receipt.panesRemaining} left, ${job.receipt.unitsDone ?? "?"} done`
      : job.abort
        ? `aborted: ${job.abort.reason} (${job.abort.panesRemaining} left)`
        : job.orphan
          ? `orphaned: ${job.orphan.reason} — relaunch?`
          : "in flight"
    return [
      job.id.padEnd(9),
      job.state.padEnd(8),
      `${job.workflow} by ${job.stoodUpBy}`.padEnd(22),
      units ? `u ${units.done}d/${units.failed}f` : "u -",
      `p ${dead}/${born}`,
      outcome,
      job.dir,
    ].join("  ")
  })
  return [`job      state    stood up by           units    panes   outcome                     dir`, ...rows].join("\n")
}

/** @param {JobRecord} job @param {LivePane[]} live */
function livePanesOf(job, live) {
  const labels = new Set(job.panes.map((p) => p.label))
  return live.filter((p) => labels.has(p.label))
}

async function main() {
  const cmd = process.argv[2]
  const jobs = listJobs()

  if (cmd === "jobs" || !cmd) {
    if (jobs.length === 0) {
      console.log("no Jobs on the OS disk")
      return
    }
    console.log(fmtJobs(jobs))
    return
  }

  if (cmd === "events") {
    const sid = process.argv[3]
    const streams = sid ? [{ sid, events: readEvents(sid) }] : readAllEvents()
    let total = 0
    for (const { sid: s, events } of streams) {
      if (events.length === 0) continue
      console.log(`== session ${s} (${events.length} events)`)
      for (const e of events) console.log(JSON.stringify(e))
      total += events.length
    }
    console.log(`events: ${total} across ${streams.filter((x) => x.events.length).length} session(s)`)
    return
  }

  if (cmd === "audit") {
    const live = shepStatus()
    const admitted = new Set(jobs.flatMap((job) => job.panes.map((p) => p.label)))
    const bastards = live.filter((p) => !admitted.has(p.label))
    const stalled = jobs.filter((job) => job.state === "running" && !pidAlive(job.pid))
    console.log(`panes live in shep: ${live.length}; admitted by Jobs: ${live.length - bastards.length}`)
    for (const pane of bastards) {
      console.log(`UNADMITTED ${pane.label} (${pane.pane}) — born outside JEV; retire it: shep retire ${pane.label}`)
    }
    for (const job of stalled) {
      console.log(`STALLED ${job.id} — orchestrator pid ${job.pid} is gone; run: agentic-os sweep`)
    }
    console.log(bastards.length === 0 && stalled.length === 0 ? "audit: clean" : `audit: ${bastards.length} unadmitted, ${stalled.length} stalled`)
    process.exitCode = bastards.length === 0 && stalled.length === 0 ? 0 : 1
    return
  }

  if (cmd === "sweep") {
    const live = shepStatus()
    let swept = 0
    for (const job of jobs) {
      if (job.state !== "running") continue
      if (pidAlive(job.pid)) {
        console.log(`${job.id} running (pid ${job.pid}) — left alone`)
        continue
      }
      const orphans = livePanesOf(job, live)
      orphanJob(job, `orchestrator pid ${job.pid ?? "?"} gone`, orphans.length)
      swept += 1
      console.log(`${job.id} orphaned (parked, ask-first) — ${job.dir}`)
      console.log(`  relaunch: agentic-os relaunch ${job.id} | decline: agentic-os abort ${job.id}`)
      if (orphans.length > 0) {
        console.log(`  straggler panes still live (relaunch retires them): ${orphans.map((p) => p.label).join(", ")}`)
      }
    }
    console.log(swept === 0 ? "sweep: nothing to settle" : `sweep: ${swept} Job(s) parked for relaunch decision`)
    return
  }

  if (cmd === "relaunch") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`relaunch: no such Job '${jid ?? ""}' — run: agentic-os jobs`)
      process.exitCode = 2
      return
    }
    if (job.state !== "orphaned") {
      console.error(`relaunch: ${job.id} is ${job.state}, not orphaned — run: agentic-os sweep`)
      process.exitCode = 2
      return
    }
    const tries = job.relaunches ?? 0
    if (tries >= RELAUNCH_CAP) {
      console.error(`relaunch: ${job.id} already relaunched ${tries}x (cap ${RELAUNCH_CAP}) — decline: agentic-os abort ${job.id}`)
      process.exitCode = 2
      return
    }
    // Stragglers first (2026-10-01 stress-test): a live pane from the
    // dead generation would double-write a unit dir and poison the
    // receipt. Retire every pane of the old generation, then relaunch.
    for (const pane of job.panes.filter((p) => p.died === undefined)) {
      try {
        execFileSync("shep", ["retire", pane.label], { timeout: 30_000 })
      } catch {}
      killPane(job, pane.label)
    }
    const orchestrator = join(import.meta.dirname, "fan-out-orchestrator")
    const logFd = openSync(join(job.dir, "orchestrator.log"), "a")
    const child = spawn(process.execPath, ["--experimental-strip-types", orchestrator, job.dir], {
      detached: true,
      stdio: ["ignore", logFd, logFd],
      env: { ...process.env, AGENTIC_OS_SID: job.sid, AGENTIC_OS_JID: job.id },
    })
    child.unref()
    relaunchJob(job, child.pid)
    console.log(`relaunched ${job.id} (pid ${child.pid}, try ${tries + 1}/${RELAUNCH_CAP}) — log: ${join(job.dir, "orchestrator.log")}`)
    return
  }

  if (cmd === "abort") {
    const jid = process.argv[3]
    const job = jobs.find((j) => j.id === jid)
    if (!jid || !job) {
      console.error(`abort: no such Job '${jid ?? ""}' — run: agentic-os jobs`)
      process.exitCode = 2
      return
    }
    if (job.state === "retired") {
      console.error(`abort: ${job.id} is already retired`)
      process.exitCode = 2
      return
    }
    if (job.state === "running" && pidAlive(job.pid)) {
      // graceful stop: the orchestrator's signal handler books the abort
      try {
        process.kill(job.pid, "SIGTERM")
        console.log(`abort: signalled orchestrator pid ${job.pid} — ${job.id} aborts itself`)
        return
      } catch (err) {
        console.error(`abort: could not signal pid ${job.pid} (${err.message}) — declining on record`)
      }
    }
    const live = shepStatus()
    abortJob(job, "declined by user", livePanesOf(job, live).length, "first_mate")
    console.log(`aborted ${job.id} (declined) — ${job.dir}`)
    return
  }

  console.error("usage: agentic-os jobs | events [sid] | audit | sweep | relaunch <jid> | abort <jid>")
  process.exitCode = 2
}

await main()
