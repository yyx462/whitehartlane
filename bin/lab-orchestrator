#!/usr/bin/env -S node --experimental-strip-types
// The lab rail door. A professor pane, then student panes. Not fan-out.
// Idle until a queue message: a log line, a pane wait, or the next
// deadline. No poll. AGENTIC_OS_CHECK_MS is only the watch-failure backstop.
// Thin door: the machinery lives in src/rail.ts (Rail), the engines in
// src/lab.ts (runLab: spur/wave lab) and src/coworker-run.ts (runCoworker:
// zen 6 relay), the epilogue in Rail.run. Plain JS on purpose: this file
// has no extension, so Node will not type-strip it. The modules it
// imports are .ts and strip fine.
// Usage: bin/lab-orchestrator <taskDir>
import { readFileSync } from "node:fs"
import { join, resolve } from "node:path"
import { runCoworker } from "../src/coworker-run.ts"
import { runLab } from "../src/lab.ts"
import { Rail } from "../src/rail.ts"
import { workflowKind } from "../src/workflow-kind.ts"

const argvDir = process.argv[2] ? resolve(process.argv[2]) : null
// A program names extra roots its workers may touch: roots.txt beside
// the spur file, one absolute path per line, staged by the run door. No env
// names — a program is data files, not shell plumbing; no tenant is
// special to the rail.
const programRoots = (() => {
  try {
    return readFileSync(join(argvDir ?? process.cwd(), "roots.txt"), "utf8")
      .split("\n")
      .map((line) => line.trim())
      .filter((line) => line.length > 0)
  } catch {
    return []
  }
})()
const rail = new Rail({ argvDir, workflow: "lab", programRoots })
rail.writePermissions() // per-run opencode.json: no external-dir prompts inside this run
// SIGINT aborts; SIGTERM drains when an engine installs a drainHook
// (ADR 5: coworker parks on it), else aborts as ever.
rail.trapSignals({ termDrains: true })

function workflowKindOf(dir) {
  try {
    return workflowKind(readFileSync(join(dir, "workflow.toml"), "utf8"))
  } catch {
    return "fan-out"
  }
}

const engine = workflowKindOf(rail.taskDir) === "coworker"
  ? () => runCoworker(rail)
  : () => runLab(rail)
process.exit(await rail.run(engine))
