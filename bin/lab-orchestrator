#!/usr/bin/env -S node --experimental-strip-types
// The lab rail. A professor pane, then student panes. Not fan-out.
// Idle until a queue message: a log line, a pane wait, or the next
// deadline. No poll. AGENTIC_OS_CHECK_MS is only the watch-failure backstop.
// Plain JS on purpose: this file has no extension, so Node will not
// type-strip it. The modules it imports are .ts and strip fine.
// Usage: bin/lab-orchestrator <taskDir>
import { execFileSync, spawn } from "node:child_process"
import { appendFileSync, existsSync, mkdirSync, readFileSync, watch, writeFileSync } from "node:fs"
import { basename, join, resolve } from "node:path"
import { loadManifest, runCounts, runEndDetector, runGateDetector, runGrade, runSignalDetector } from "../src/hooks.ts"
import { loadDagFile, tick } from "../src/dag.ts"
import { memberProtocol, parseMembers, readMessages, relayPlan, combineFirstPrompt } from "../src/coworker.ts"
import { workflowKind } from "../src/workflow-kind.ts"
import { decidePermission } from "../src/permission.ts"
import { withBackpressure } from "../src/backpressure.ts"
import { drop, emptyBoard, note, place } from "../src/lanes.ts"
import { gradeCall } from "../src/live-grade.ts"
import { endOf, readSignal, wakesFor, waveClosed } from "../src/live-run.ts"
import { paneLabeler, runIdFor, runOrchestrator } from "../src/orchestrator.ts"
import { writeReport } from "../src/report.ts"
import { actorBrief, orchestratorBrief, paneName } from "../src/roles.ts"
import { beat, closes, note as sayOnce, verboseOn } from "../src/verbose.ts"
import {
  abortJob as abortJobRec,
  addWorkerRoot,
  appendEvent,
  attachPane,
  createJob,
  finishJob as finishJobRec,
  jobRunDir,
  killPane,
  loadJob,
  openSession,
  readEvents,
  saveJob,
  modelIn,
  splitModel,
  writePiSettings,
  writeWorkerPermissions,
} from "../src/store.ts"

const argvDir = process.argv[2] ? resolve(process.argv[2]) : null
const log = (msg) => console.log(`${new Date().toISOString()} ${msg}`)

function taskLine(dir) {
  try {
    return readFileSync(join(dir, "task.txt"), "utf8").split("\n")[0]?.slice(0, 120) || basename(dir)
  } catch {
    return basename(dir)
  }
}

// The Job ledger (zen 2/5). Bookkeeping must never break the rail: every
// ledger call is best-effort, and a run without a record still runs.
// Events are the trace; job.json is the projection the store maintains.
const ledger = (() => {
  try {
    let job = null
    const { AGENTIC_OS_SID: sid0, AGENTIC_OS_JID: jid0 } = process.env
    if (sid0 && jid0) job = loadJob(sid0, jid0)
    if (!job) {
      const sess = openSession({ cwd: argvDir ?? process.cwd() })
      job = createJob({
        sid: sess.id,
        stoodUpBy: "standalone",
        workflow: "fan-out",
        task: argvDir ? taskLine(argvDir) : "standalone run",
        dir: argvDir ?? jobRunDir(sess.id, "pending"),
      })
      if (!argvDir) {
        job.dir = jobRunDir(sess.id, job.id)
        job.task = "standalone run"
        saveJob(job)
      }
      log(`job ${job.id} self-opened on session ${job.sid} (no AGENTIC_OS_SID/JID passed)`)
    }
    job.pid = process.pid
    saveJob(job)
    return {
      job,
      emit(kind, payload) {
        try {
          appendEvent(job.sid, { actor: "orchestrator", jid: job.id, kind, ...payload })
        } catch {}
      },
      attach(label, pane, unit, transcript, seed) {
        try {
          attachPane(job, { label, pane, unit, parent: "orchestrator", transcript, seed })
        } catch {}
      },
      kill(label) {
        try {
          killPane(job, label)
        } catch {}
      },
      finish(receipt) {
        try {
          finishJobRec(job, receipt)
          log(`job ${job.id} retired — receipt: panes remaining ${receipt.panesRemaining}/${job.panes.length}`)
        } catch (err) {
          log(`ledger: finish failed (${err.message})`)
        }
      },
      abort(reason, panesRemaining) {
        try {
          abortJobRec(job, reason, panesRemaining)
          log(`job ${job.id} aborted (${reason}) — panes remaining ${panesRemaining}`)
        } catch {}
      },
    }
  } catch (err) {
    log(`ledger unavailable (${err.message}) — running without a Job record`)
    return null
  }
})()

const taskDir = argvDir ?? ledger?.job.dir ?? resolve(process.cwd())
const scoped = paneLabeler(runIdFor(taskDir))
const workerModel = modelIn(taskDir)
// A program names extra roots its workers may touch: roots.txt beside
// the dag, one absolute path per line, staged by the run door. No env
// names — a program is data files, not shell plumbing; no tenant is
// special to the rail.
const programRoots = (() => {
  try {
    return readFileSync(join(taskDir, "roots.txt"), "utf8")
      .split("\n")
      .map((line) => line.trim())
      .filter((line) => line.length > 0)
  } catch {
    return []
  }
})()
writeWorkerPermissions(taskDir) // per-run opencode.json: no external-dir prompts inside this run

for (const sig of ["SIGTERM", "SIGINT"]) {
  process.on(sig, () => {
    ledger?.abort(`signal ${sig}`, mine.size)
    process.exit(0)
  })
}

function run(cmd, args) {
  try {
    const stdout = execFileSync(cmd, args, { encoding: "utf8", timeout: 90_000 })
    return { status: 0, stdout }
  } catch (err) {
    return { status: typeof err.status === "number" ? err.status : 1, stdout: err.stdout ?? "" }
  }
}

const shep = (...args) => run("shep", args)
const herdr = (...args) => run("herdr", args)
const mine = new Set()

function jsonAt(out, pick) {
  for (const line of out.split("\n").reverse()) {
    const t = line.trim()
    if (!t.startsWith("{")) continue
    try {
      return pick(JSON.parse(t))
    } catch {
      // keep looking
    }
  }
  return null
}

const START_TIMEOUT_MS = 60_000

function liveWorkflow(dir) {
  try {
    return /^\s*live\s*=\s*true\s*$/m.test(readFileSync(join(dir, "workflow.toml"), "utf8"))
  } catch {
    return false
  }
}

// -- fleet tab state (layout tab = "new") ------------------------------------
let layout = { tab: "same", orchestrator: "left" }
let fleetRoot = null // root pane of the fleet tab (unused directly when split)
let viewerPane = null // the orchestrator lane: full-height side pane
let actorPane = null
let colPane = null // top pane of the worker column
let colUsed = false // has the column head been taken by the first worker?
const liveWorkerPanes = [] // pane ids of settled-not-yet workers (splittable anchors)
const paneOf = new Map() // scoped label -> pane id

const WORKER_SHARE = 0.5

function splitPane(fromPane, direction, cwd, ratio) {
  const r = herdr(
    "pane", "split", "--pane", fromPane, "--direction", direction,
    "--ratio", String(ratio), "--cwd", cwd, "--no-focus",
  )
  return jsonAt(r.stdout, (d) => d?.result?.pane?.pane_id ?? null)
}

function openFleetTab(dir) {
  const label = `fan-out-${basename(dir)}`.slice(0, 40)
  const r = herdr("tab", "create", "--label", label, "--cwd", dir, "--no-focus")
  const root = jsonAt(r.stdout, (d) => d?.result?.root_pane?.pane_id ?? null)
  if (!root) {
    log(`fleet tab unavailable (rc=${r.status}) — falling back to same-tab layout`)
    layout = { ...layout, tab: "same" }
    return
  }
  fleetRoot = root
  // The tab root is not a shell. Split a shell, close the root, then
  // split that shell 50-50. The lane and the worker column are both new panes.
  const shell = splitPane(root, "right", dir, 0.5)
  if (!shell) {
    log("fleet pre-split failed — falling back to same-tab layout")
    layout = { ...layout, tab: "same" }
    fleetRoot = null
    return
  }
  herdr("pane", "close", root)
  const side = splitPane(shell, "right", dir, WORKER_SHARE)
  if (!side) {
    log("fleet pre-split failed — falling back to same-tab layout")
    layout = { ...layout, tab: "same" }
    fleetRoot = null
    return
  }
  if (layout.orchestrator === "left") {
    viewerPane = shell
    colPane = side
  } else {
    viewerPane = side
    colPane = shell
  }
  log(`fleet tab ${label} opened (workers ${WORKER_SHARE} / lane ${1 - WORKER_SHARE})`)
}

// start an agent in an existing pane, record it, submit the brief.
// since is stamped BEFORE the agent starts, so the host tool's session
// (created during start) always falls inside the pointer's window.
function inhabitPane(rawName, kind, pane, briefPath, cwd, model = workerModel, seed = undefined, hold = false) {
  const since = new Date().toISOString()
  const name = scoped(rawName)
  const rec = shep("record", pane, name)
  if (rec.status !== 0) {
    // an unrecorded split pane would leak as a bare shell — close it
    herdr("pane", "close", pane)
    ledger?.emit("reject", { label: name, why: "record failed" })
    log(`record failed for ${name} on pane ${pane} — pane closed`)
    return false
  }
  const startArgs = []
  if (model && kind === "pi") {
    writePiSettings(cwd, model)
    const { provider, id } = splitModel(model)
    startArgs.push("--", "--approve", "--provider", provider, "--model", id)
  } else if (model && kind === "opencode") {
    startArgs.push("--", "--model", model)
  }
  const start = herdr("agent", "start", name, "--kind", kind, "--pane", pane, "--timeout", String(START_TIMEOUT_MS), ...startArgs)
  if (start.status !== 0) {
    shep("retire", name)
    ledger?.emit("reject", { label: name, why: "agent start failed" })
    log(`agent start failed for ${name} (rc=${start.status}) — ghost cleared`)
    return false
  }
  // hold: a coworker member that does not initiate is born idle — its
  // brief rides WITH the first relayed message (zen 6: the rail is the
  // watcher; the member never polls, never sleeps, never waits)
  if (!hold) {
    const brief = readFileSync(briefPath, "utf8")
    const prompt = herdr("agent", "prompt", name, brief)
    if (prompt.status !== 0) {
      log(`brief submission failed for ${name} — the grace reprompt will retry`)
    }
  }
  mine.add(name)
  ledger?.attach(
    name,
    pane,
    name.startsWith("orch-lane") ? undefined : name,
    { tool: kind, cwd, since },
    seed,
  )
  return true
}

const port = {
  setLayout(want, dir) {
    layout = want
    if (want.tab === "new") openFleetTab(dir)
  },

  spawnWorker: (name, kind, briefPath, cwd) => {
    const label = scoped(name)
    if (layout.tab === "new" && colPane) {
      // Split from a LIVE pane only: retired workers close their panes, so
      // a stale anchor pane_not_found's (2026-09-29 09:41 run). Try the
      // newest live worker downward, any older live worker, then a fresh
      // column beside the lane pane.
      let pane = null
      if (!colUsed) {
        // Split the column head for the first worker too — a split sets
        // the unit cwd deterministically (no cd race); the empty head
        // closes and the worker takes the column.
        pane = splitPane(colPane, "down", cwd, 0.5)
        if (pane) herdr("pane", "close", colPane)
        colUsed = true
      } else {
        for (const anchor of [...liveWorkerPanes].reverse()) {
          pane = splitPane(anchor, "down", cwd, 0.5)
          if (pane) break
        }
        if (!pane && viewerPane) {
          pane = splitPane(viewerPane, "right", cwd, 0.7)
        }
      }
      if (!pane) {
        log(`pane split failed for ${label} — no live anchor`)
        return false
      }
      const ok = inhabitPane(name, kind, pane, briefPath, cwd)
      if (ok) {
        liveWorkerPanes.push(pane)
        paneOf.set(label, pane)
        log(`spawned ${label} (${kind}) in fleet tab pane ${pane}`)
      }
      return ok
    }
    const r = shep("spawn", label, "--kind", kind, "--cwd", cwd, "--brief", `@${briefPath}`)
    if (r.status !== 0) {
      shep("retire", label)
      ledger?.emit("reject", { label, why: "spawn failed" })
      log(`spawn failed for ${label} (rc=${r.status}) — ghost cleared`)
      return false
    }
    mine.add(label)
    ledger?.attach(label, undefined, name, { tool: kind, cwd, since: new Date().toISOString() })
    log(`spawned ${label} (${kind})`)
    return true
  },

  paneAlive: (name) => herdr("agent", "get", scoped(name)).status === 0,

  reprompt: (name, briefPath) => {
    try {
      const brief = readFileSync(briefPath, "utf8")
      const r = herdr("agent", "prompt", scoped(name), brief)
      if (r.status === 0) log(`reprompted ${scoped(name)} (brief re-submitted)`)
      return r.status === 0
    } catch {
      return false
    }
  },

  retire: (name) => {
    const label = scoped(name)
    const r = shep("retire", label)
    if (r.status !== 0) shep("prune")
    mine.delete(label)
    ledger?.kill(label)
    const pane = paneOf.get(label)
    paneOf.delete(label)
    if (pane) {
      const i = liveWorkerPanes.indexOf(pane)
      if (i >= 0) liveWorkerPanes.splice(i, 1)
    }
    log(`retired ${label}`)
  },

  retireAll: () => {
    for (const name of [...mine]) {
      const r = shep("retire", name)
      if (r.status !== 0) shep("prune")
      ledger?.kill(name)
    }
    mine.clear()
    paneOf.clear()
    liveWorkerPanes.length = 0
    log("retired every pane this orchestrator spawned")
  },

  verify: () => {
    const r = shep("verify")
    const line = r.stdout.split("\n").find((l) => l.includes("pane-reap:"))
    return (line ?? "pane-reap: ? remaining").trim()
  },

  wake: (label, kind, detail) => {
    shep("wake", "queue", label, kind, detail)
    log(`wake ${label} ${kind}: ${detail}`)
  },

  waitWorker: (name, timeoutMs) => new Promise((resolve) => {
    const started = Date.now()
    const child = spawn("herdr", [
      "agent", "wait", scoped(name),
      "--until", "done", "--until", "blocked",
      "--timeout", String(timeoutMs),
    ], { stdio: "ignore" })
    child.on("error", () => resolve("miss"))
    child.on("close", () => {
      // A wait that returns at once is not an event. Re-arming it spins.
      if (Date.now() - started < 1000) resolve("miss")
      else resolve("woke")
    })
  }),

  tailPane: (logPath) => {
    if (layout.tab === "new" && viewerPane && liveWorkflow(taskDir)) {
      mkdirSync(join(taskDir, "briefs"), { recursive: true })
      const briefPath = join(taskDir, "briefs", "orch-lane.md")
      writeFileSync(briefPath, orchestratorBrief())
      const ok = inhabitPane("orch-lane", "pi", viewerPane, briefPath, taskDir)
      log(ok ? `orchestrator pane born (fleet tab pane ${viewerPane})` : "orchestrator pane failed")
      return ok
    }
    if (layout.tab === "new" && viewerPane) {
      const child = spawn("herdr", ["pane", "run", viewerPane, "tail", "-n", "+1", "-F", logPath], {
        detached: true,
        stdio: "ignore",
      })
      child.on("error", () => {})
      child.unref()
      log(`lane pane tailing this log (fleet tab pane ${viewerPane})`)
      return true
    }
    mkdirSync(join(taskDir, "briefs"), { recursive: true })
    const briefPath = join(taskDir, "briefs", "orch-lane.md")
    writeFileSync(
      briefPath,
      [
        "You are a log viewer. Run exactly this one command, then do nothing:",
        `tail -n +1 -F ${logPath}`,
        "",
        "Never do any other work. Never edit any file. If the tail command",
        "exits, run it again and idle.",
      ].join("\n"),
    )
    const label = scoped("orch-lane")
    const since = new Date().toISOString()
    const r = shep(
      "spawn", label, "--kind", "pi", "--cwd", taskDir,
      "--dir", "right", "--brief", `@${briefPath}`,
    )
    if (r.status !== 0) {
      shep("retire", label) // a failed spawn keeps its ledger entry — clear the ghost
      log("lane pane unavailable — read the orchestrator log instead")
      return false
    }
    mine.add(label)
    ledger?.attach(label, undefined, undefined, { tool: "pi", cwd: taskDir, since })
    return true
  },
}

function waitChange(dir, ms) {
  return new Promise((resolve) => {
    let done = false
    let watcher = null
    const finish = () => {
      if (done) return
      done = true
      clearTimeout(timer)
      try { watcher?.close() } catch {}
      resolve()
    }
    const timer = setTimeout(finish, ms)
    try {
      watcher = watch(dir, finish)
    } catch {
      // the timer is the backstop
    }
  })
}

function mockEnd(id, spawnedAt) {
  const logPath = join(taskDir, "units", id, "log.txt")
  const log = existsSync(logPath) ? readFileSync(logPath, "utf8") : ""
  return endOf(log, id, port.paneAlive(paneName("mock", id)), Date.now() - spawnedAt)
}

function layoutOf(pane) {
  const r = herdr("pane", "layout", "--pane", pane)
  return jsonAt(r.stdout, (d) => d?.result?.layout ?? null)
}

function equalize(ids, axis) {
  if (ids.length < 2) return
  for (let pass = 0; pass < 8; pass++) {
    const lay = layoutOf(ids[0])
    if (!lay) return
    const total = axis === "x" ? lay.area.width : lay.area.height
    const byId = new Map(lay.panes.map((pane) => [pane.pane_id, pane.rect]))
    const target = total / ids.length
    let moved = false
    for (let i = 0; i < ids.length - 1; i++) {
      const rect = byId.get(ids[i])
      if (!rect) continue
      const size = axis === "x" ? rect.width : rect.height
      const delta = size - target
      if (Math.abs(delta) < 2) continue
      const amount = Math.min(0.4, Math.abs(delta) / total)
      const dir = axis === "x" ? (delta > 0 ? "left" : "right") : (delta > 0 ? "up" : "down")
      herdr("pane", "resize", "--pane", ids[i + 1], "--direction", dir, "--amount", String(amount))
      moved = true
      break
    }
    if (!moved) return
  }
}

function wantVerbose(dir) {
  if (process.env.AGENTIC_OS_VERBOSE === "1") return true
  try {
    return verboseOn(readFileSync(join(dir, "workflow.toml"), "utf8"))
  } catch {
    return false
  }
}

const seen = new Map()
let verbosePath = null
let verbosePane = null

function say(who, what) {
  const line = sayOnce(seen, `${who} ${what}`, beat(who, what))
  if (!line) return
  log(line)
  if (verbosePath) appendFileSync(verbosePath, `${new Date().toISOString()} ${line}\n`)
}

function openVerbose(dir) {
  const path = join(dir, "verbose.log")
  writeFileSync(path, "")
  const pane = openShell(dir, "verbose")
  if (!pane) {
    log("verbose tab failed")
    return
  }
  verbosePath = path
  verbosePane = pane
  herdr("pane", "rename", pane, "verbose")
  const child = spawn("herdr", ["pane", "run", pane, "tail", "-n", "+1", "-F", path], {
    detached: true,
    stdio: "ignore",
  })
  child.on("error", () => {})
  child.unref()
  say("rail", "verbose tab open")
}

function openShell(dir, label) {
  const r = herdr("tab", "create", "--label", label.slice(0, 40), "--cwd", dir, "--no-focus")
  const root = jsonAt(r.stdout, (d) => d?.result?.root_pane?.pane_id ?? null)
  if (!root) return null
  const shell = splitPane(root, "right", dir, 0.5)
  if (!shell) return null
  herdr("pane", "close", root)
  return shell
}

function ensureRole(board, role, dir) {
  const placed = place(board, role)
  if (placed.kind === "first" || placed.kind === "overflow-tab") {
    const pane = openShell(dir, role)
    if (!pane) return { board, pane: null }
    return { board: note(board, placed, pane), pane }
  }
  if (placed.kind === "have") {
    return { board, pane: board.tabs[placed.tab].lanes[placed.lane].panes[0] }
  }
  if (placed.kind === "lane") {
    const tab = board.tabs[placed.tab]
    const from = tab.lanes[tab.lanes.length - 1].panes[0]
    const pane = splitPane(from, "right", dir, 0.5)
    if (!pane) return { board, pane: null }
    const next = note(board, placed, pane)
    equalize(next.tabs[placed.tab].lanes.map((lane) => lane.panes[0]), "x")
    return { board: next, pane }
  }
  const lane = board.tabs[placed.tab].lanes[placed.lane]
  const from = lane.panes[lane.panes.length - 1]
  const pane = splitPane(from, "down", dir, 0.5)
  if (!pane) return { board, pane: null }
  const next = note(board, placed, pane)
  equalize(next.tabs[placed.tab].lanes[placed.lane].panes, "y")
  return { board: next, pane }
}

async function runLive() {
  let jobText = ""
  try { jobText = readFileSync(join(taskDir, "actor.md"), "utf8") } catch {}
  // A lab program is one dag file. When it is staged beside this run,
  // the file is the scheduler's input: tick() decides every birth,
  // grade, prompt, and reopen. No second scheduler exists — the file
  // is read, never executed.
  const dag = (() => {
    try {
      return loadDagFile(join(taskDir, "dag.mjs"))
    } catch {
      return null
    }
  })()
  // Detectors: the program's say in what a wave or an end is. Absent,
  // the OS defaults (protocol.json, log.txt) run — a detector may
  // slow or fail, never kill the rail: refusal retries, deterministic
  // failure degrades and logs once.
  const manifestEarly = (() => {
    try {
      return loadManifest(taskDir)
    } catch {
      return null
    }
  })()
  const detectors = manifestEarly?.detectors
  const gateSteps = dag ? dag.steps.filter((s) => s.does === "gate") : []
  const gateMissed = gateSteps.filter((s) => !manifestEarly?.gates?.[s.id])
  if (gateMissed.length > 0) {
    log(`gate step ${gateMissed.map((s) => s.id).join(", ")} has no [gates] detector — refusing`)
    process.exit(1)
  }
  const saidDetectorFailure = new Set()
  function detectorCall(what, fn, fallback) {
    try {
      return withBackpressure(fn, { who: what, log })
    } catch (err) {
      const line = `${what} failed: ${err && err.message ? err.message : err}`
      if (!saidDetectorFailure.has(line)) {
        saidDetectorFailure.add(line)
        log(line)
      }
      return fallback
    }
  }
  let board = emptyBoard()
  if (wantVerbose(taskDir)) openVerbose(taskDir)
  mkdirSync(join(taskDir, "briefs"), { recursive: true })
  const orchPath = join(taskDir, "briefs", "orchestrator.md")
  writeFileSync(orchPath, orchestratorBrief())
  const orch = ensureRole(board, "orchestrator", taskDir)
  board = orch.board
  if (orch.pane && inhabitPane("orchestrator", "pi", orch.pane, orchPath, taskDir)) {
    herdr("pane", "rename", orch.pane, "orchestrator")
    log(`name orchestrator pane ${orch.pane}`)
    say("rail", "birth orchestrator")
  } else {
    log("orchestrator pane failed")
  }
  const actorPath = join(taskDir, "briefs", "actor.md")
  writeFileSync(actorPath, actorBrief(jobText))
  const born = new Map()
  const mockPane = new Map()
  const closed = new Set()
  const graded = new Map()
  const woke = []
  const settled = []
  let prompted = ""
  const kind = (() => {
    try {
      return readFileSync(join(taskDir, "workflow.toml"), "utf8").match(/worker_kind\s*=\s*"([^"]+)"/)?.[1] ?? "opencode"
    } catch {
      return "opencode"
    }
  })()

  function spawnWave(units) {
    for (const unit of units) {
      if (born.has(unit.id)) continue
      const dir = join(taskDir, "units", unit.id)
      mkdirSync(dir, { recursive: true })
      const briefPath = join(dir, "brief.md")
      const name = paneName("mock", unit.id)
      writeFileSync(briefPath, [
        unit.brief,
        "",
        "When you finish, append exactly this line to the log file",
        `${join(dir, "log.txt")} :`,
        `done ${unit.id}`,
        "",
        "If you cannot proceed, append exactly this line and stop:",
        `blocked ${unit.id}: <why>`,
        "",
        `Write what you generated to ${join(dir, "result.md")}`,
      ].join("\n"))
      const roots = [taskDir, ...programRoots]
      writeWorkerPermissions(dir, roots)
      const slot = ensureRole(board, "mock", dir)
      board = slot.board
      const ok = slot.pane ? inhabitPane(name, kind, slot.pane, briefPath, dir) : false
      if (slot.pane) herdr("pane", "rename", slot.pane, name)
      born.set(unit.id, Date.now())
      if (slot.pane) mockPane.set(unit.id, slot.pane)
      log(ok ? `name ${name} pane ${slot.pane}` : `mock ${name} failed to spawn`)
      if (ok) say("rail", `birth ${name}`)
    }
  }

  function gradeUnit(id) {
    try {
      graded.set(id, runGrade(taskDir, loadManifest(taskDir), { id, brief: "" }))
      say("rail", `grade ${paneName("mock", id)}`)
    } catch (err) {
      graded.set(id, { pass: false, row: "fail grade" })
      log(`grade ${id} failed: ${err instanceof Error ? err.message : err}`)
    }
  }

  function promptActor(ends) {
    herdr("agent", "prompt", scoped("actor"), [
      "Wave closed.",
      ...ends.map((row) => `${paneName("mock", row.id)}: ${row.end}`),
      "Results are under units/.",
      "Write the next protocol.json, or {\"stop\":true}.",
    ].join("\n"))
    log("prompted actor")
    say("rail", "prompt actor")
  }

  function birthActor() {
    const actor = ensureRole(board, "actor", taskDir)
    board = actor.board
    if (actor.pane && inhabitPane("actor", "pi", actor.pane, actorPath, taskDir)) {
      herdr("pane", "rename", actor.pane, "actor")
      log(`name actor pane ${actor.pane}`)
      say("rail", "birth actor")
    } else {
      log("actor pane failed")
    }
  }

  // dag drives the actor's birth; a workflow.toml lab births it here
  if (!dag) birthActor()

  const done = new Set()
  let actorBorn = !!dag ? false : true
  let openedWave = ""
  let promptedDag = false
  const deadline = Date.now() + 2 * 60 * 60_000
  while (Date.now() < deadline) {
    const signal = detectors?.signal
      ? detectorCall("signal detector", () => runSignalDetector(taskDir, manifestEarly), { kind: "missing" })
      : readSignal(taskDir)
    const ends = [...born].map(([id, at]) => {
      let end = detectors?.end
        ? detectorCall(`end detector ${id}`, () => runEndDetector(taskDir, manifestEarly, id), null)
        : mockEnd(id, at)
      // liveness stays rail-owned: a dead pane is dead even under a
      // custom end detector, and herdr still names the blocked
      if (!end && Date.now() - at > 15_000 && !port.paneAlive(paneName("mock", id))) end = "dead"
      if (!end && herdr("agent", "get", scoped(paneName("mock", id))).stdout.includes('"agent_status":"blocked"')) {
        end = "blocked"
      }
      return { id, end }
    })
    const gatesReady = []
    for (const step of gateSteps) {
      if (done.has(step.id) || !step.after.every((id) => done.has(id))) continue
      const ready = detectorCall(`gate ${step.id}`, () => runGateDetector(taskDir, manifestEarly, step.id), false)
      if (ready) {
        gatesReady.push(step.id)
        say("rail", `gate ${step.id} ready`)
      }
    }
    let stopNow = false
    let reopened = false
    if (dag) {
      const waveKey = signal.kind === "wave" ? signal.wave.units.map((unit) => unit.id).join(",") : ""
      const actions = tick(dag, {
        done: [...done],
        actorBorn,
        signal: signal.kind,
        waveKey,
        openedWave,
        ends,
        graded: [...graded.keys()],
        prompted: promptedDag,
        gatesReady,
      })
      for (const action of actions) {
        if (action.do === "birth-actor") {
          birthActor()
          actorBorn = true
        } else if (action.do === "birth-wave") {
          if (signal.kind === "wave") {
            spawnWave(signal.wave.units)
            openedWave = waveKey
          }
        } else if (action.do === "grade") {
          gradeUnit(action.id)
        } else if (action.do === "prompt-actor") {
          promptActor(ends)
          promptedDag = true
        } else if (action.do === "finish") {
          done.add(action.id)
        } else if (action.do === "reopen") {
          for (const id of action.ids) done.delete(id)
          born.clear()
          mockPane.clear()
          closed.clear()
          graded.clear()
          promptedDag = false
          reopened = true
          say("rail", `reopen ${action.ids.join(", ")}`)
        } else if (action.do === "report") {
          stopNow = true
        }
      }
      if (stopNow || signal.kind === "stop") break
    } else {
      if (signal.kind === "stop") break
      if (signal.kind === "wave") spawnWave(signal.wave.units)
    }
    for (const id of wakesFor(ends, woke)) {
      woke.push(id)
      herdr("agent", "prompt", scoped("orchestrator"), `${paneName("mock", id)} is blocked: waiting for a permission or a decision. Name that pane. Do not spawn.`)
      log(`wake orchestrator ${paneName("mock", id)} blocked`)
      say("watcher", `${paneName("mock", id)} blocked`)
      say("rail", `prompt orchestrator ${paneName("mock", id)}`)
    }
    if (reopened) {
      await waitChange(taskDir, 30_000)
      continue
    }
    for (const row of ends) {
      if (!dag && gradeCall(row.end, graded.has(row.id))) gradeUnit(row.id)
      if (!closes(row.end) || closed.has(row.id)) continue
      const pane = mockPane.get(row.id)
      const name = paneName("mock", row.id)
      closed.add(row.id)
      settled.push({
        unit: row.id,
        result: graded.get(row.id)?.row ?? row.end ?? "open",
        pass: graded.has(row.id) ? graded.get(row.id).pass : row.end === "done",
      })
      if (pane) {
        herdr("pane", "close", pane)
        shep("retire", scoped(name))
        ledger?.kill(scoped(name))
        mine.delete(scoped(name))
        board = drop(board, pane)
      }
      say("operator", `close ${name}`)
    }
    if (!dag && waveClosed(ends)) {
      const mark = ends.map((row) => row.end).join(",")
      if (prompted !== mark) {
        prompted = mark
        promptActor(ends)
      }
    }
    await waitChange(taskDir, 30_000)
  }
  const finalEnds = [...born].map(([id, at]) => ({ id, end: mockEnd(id, at) }))
  const rows = dag
    ? [...settled, ...finalEnds
        .filter((row) => !closes(row.end))
        .map((row) => ({ unit: row.id, result: row.end ?? "open", pass: row.end === "done" }))]
    : finalEnds.map((row) => {
        const grade = graded.get(row.id)
        return { unit: row.id, result: grade?.row ?? row.end ?? "open", pass: grade ? grade.pass : row.end === "done" }
      })
  const stopped = readSignal(taskDir).kind === "stop"
  const report = writeReport(
    taskDir,
    taskDir,
    rows,
    (table) => runCounts(taskDir, loadManifest(taskDir), table),
    stopped && rows.every((row) => row.pass) ? "done" : rows.length === 0 && stopped ? "done" : undefined,
  )
  port.retireAll()
  if (verbosePane) herdr("pane", "close", verbosePane)
  return report
}

function workflowKindOf(dir) {
  try {
    return workflowKind(readFileSync(join(dir, "workflow.toml"), "utf8"))
  } catch {
    return "fan-out"
  }
}

// Coworker (zen 6): members talk through the rail. Birth each named
// member with its own brief and model, relay message files as prompts
// to the named pane, end on stop or the cap, then report.
async function runCoworker() {
  const toml = readFileSync(join(taskDir, "workflow.toml"), "utf8")
  const members = parseMembers(toml)
  if (members.length < 2) {
    log("coworker needs at least two [members.*]")
    process.exit(1)
  }
  const manifest = loadManifest(taskDir)
  const memberKind = manifest.workflow.worker_kind
  const names = members.map((m) => m.name)
  if (!members.some((m) => m.initiates)) {
    log("coworker needs one member with initiates = true — otherwise everyone idles and the exchange never starts")
    process.exit(1)
  }
  let board = emptyBoard()
  if (wantVerbose(taskDir)) openVerbose(taskDir)
  mkdirSync(join(taskDir, "messages"), { recursive: true })
  mkdirSync(join(taskDir, "briefs"), { recursive: true })
  const bornAt = new Map()
  const prompted = new Set()
  const sandboxOf = new Map()
  for (const m of members) {
    const dir = join(taskDir, "sandboxes", m.name)
    sandboxOf.set(m.name, dir)
    mkdirSync(dir, { recursive: true })
    writeWorkerPermissions(dir, [taskDir, ...programRoots])
    let brief = ""
    try {
      brief = readFileSync(join(taskDir, "members", `${m.name}.md`), "utf8")
    } catch {
      log(`no brief for ${m.name} — members/${m.name}.md is missing`)
      process.exit(1)
    }
    writeFileSync(
      join(taskDir, "briefs", `${m.name}.md`),
      brief + memberProtocol(m.name, names.filter((n) => n !== m.name), taskDir),
    )
    const slot = ensureRole(board, m.name, dir)
    board = slot.board
    // the initiator wakes on its brief alone; everyone else is held
    // idle until the rail delivers brief + first message together
    const ok = slot.pane
      ? inhabitPane(m.name, memberKind, slot.pane, join(taskDir, "briefs", `${m.name}.md`), dir, m.model, m.seed, !m.initiates)
      : false
    if (slot.pane) herdr("pane", "rename", slot.pane, m.name)
    if (ok && m.initiates) prompted.add(m.name)
    bornAt.set(m.name, Date.now())
    log(ok ? `name ${m.name} pane ${slot.pane}${m.initiates ? " (initiates)" : " (held idle)"}` : `member ${m.name} failed to spawn`)
    if (ok) say("rail", `birth ${m.name}`)
  }
  const CAP = Number(process.env.AGENTIC_OS_RELAY_CAP ?? "") || 60
  const deadline = Date.now() + 2 * 60 * 60_000
  const delivered = []
  const refused = []
  const dead = []
  const askedCount = new Map()
  // verdicts that arrived while the member was blocked — herdr refuses
  // to prompt a blocked pane, so the note waits for the next beat
  const pendingNote = new Map()
  // the ball: whose turn the exchange waits on. Idle too long → one
  // nudge, then a second, then the member is dead. A silent member
  // must never stall the exchange forever.
  const ballOn = { name: members.find((m) => m.initiates)?.name, since: Date.now() }
  const nudged = new Map()
  let ended = null // "stop" | "cap" | "deadline" | "dead"
  while (!ended && Date.now() < deadline) {
    const { messages, bad } = readMessages(join(taskDir, "messages"), names)
    for (const b of bad) {
      if (refused.includes(b.file)) continue
      refused.push(b.file)
      ledger?.emit("reject", { why: `message ${b.file}: ${b.why}` })
      log(`refused message ${b.file}: ${b.why}`)
      say("watcher", `refuse ${b.file}`)
    }
    // flush queued permission notes into panes that can take them
    for (const [held, note] of pendingNote) {
      const st = herdr("agent", "get", scoped(held)).stdout
      if (st.includes('"agent_status":"blocked"') || st.includes('"agent_status":"working"')) continue
      if (herdr("agent", "prompt", scoped(held), note).status === 0) {
        pendingNote.delete(held)
        log(`injected queued note into ${held}`)
      }
    }
    const plan = relayPlan(messages, delivered, CAP)
    for (const r of plan.relays) {
      const target = scoped(r.to)
      // a working member takes mail on a later beat — never mid-turn
      const state = herdr("agent", "get", target).stdout
      if (state.includes('"agent_status":"working"')) continue
      let text = `[relay] from ${r.from}:\n\n${r.body}`
      if (!prompted.has(r.to)) {
        text = combineFirstPrompt(readFileSync(join(taskDir, "briefs", `${r.to}.md`), "utf8"), r.from, r.body)
        prompted.add(r.to)
      }
      const rc = herdr("agent", "prompt", target, text)
      if (rc.status !== 0) {
        log(`relay ${r.file} could not reach ${r.to} (rc=${rc.status}) — retrying next beat`)
        continue
      }
      delivered.push(r.file)
      ballOn.name = r.to
      ballOn.since = Date.now()
      ledger?.emit("relay", { from: r.from, to: r.to, file: r.file })
      log(`relay ${r.file}: ${r.from} -> ${r.to}`)
      say("rail", `relay ${r.from} -> ${r.to}`)
    }
    if (plan.stop) {
      ended = plan.why ?? "stop"
      break
    }
    // the permission half of JEV: a blocked member is a question, and
    // the typed decider answers it — allow (roots), deny (dangerous),
    // deny-unneeded (wandering) — with a message injected back. No
    // dialog ever waits for a person. Capped like every retry surface.
    for (const m of members) {
      if (dead.includes(m.name)) continue
      const out = herdr("agent", "get", scoped(m.name)).stdout
      if (!out.includes('"agent_status":"blocked"')) continue
      const term = herdr("agent", "read", scoped(m.name)).stdout
      const at = term.lastIndexOf("Permission required")
      const question = at >= 0 ? term.slice(at, at + 2000) : term.slice(-2000)
      const verdict = decidePermission({
        question,
        allowedRoots: [taskDir, sandboxOf.get(m.name) ?? "", ...programRoots],
      })
      const asked = (askedCount.get(m.name) ?? 0) + 1
      askedCount.set(m.name, asked)
      if (verdict.decision === "allow" && verdict.path) {
        addWorkerRoot(sandboxOf.get(m.name) ?? taskDir, verdict.path.replace(/\/[^/]*$/, ""))
        herdr("agent", "send-keys", scoped(m.name), "enter")
      } else {
        herdr("agent", "send-keys", scoped(m.name), "esc")
        const note = `[permission] ${verdict.message}`
        const rc = herdr("agent", "prompt", scoped(m.name), note)
        if (rc.status !== 0) pendingNote.set(m.name, note)
      }
      ledger?.emit("permission", { member: m.name, decision: verdict.decision, path: verdict.path, ask: asked })
      log(`permission ${m.name} #${asked}: ${verdict.decision} ${verdict.path ?? "(no path)"}`)
      say("watcher", `permission ${m.name} ${verdict.decision}`)
      if (asked >= 6) {
        dead.push(m.name)
        ledger?.emit("wake", { why: `member ${m.name} blocked past the permission cap` })
        log(`member ${m.name} hit the permission cap (6) — ending`)
      }
    }
    // the stall guard: whoever holds the ball and idles too long gets
    // nudged — twice, then the exchange ends. Working resets the clock.
    if (ballOn.name && !dead.includes(ballOn.name)) {
      const st = herdr("agent", "get", scoped(ballOn.name)).stdout
      if (st.includes('"agent_status":"working"')) {
        ballOn.since = Date.now()
      } else if (Date.now() - ballOn.since > 120_000) {
        const used = nudged.get(ballOn.name) ?? 0
        if (used < 2) {
          nudged.set(ballOn.name, used + 1)
          herdr(
            "agent", "prompt", scoped(ballOn.name),
            used === 0
              ? "The exchange waits on you. Continue your task now; when you have something for a peer, write your message file (messages/<seq>-<name>.json)."
              : `Second and final nudge, ${ballOn.name}: the exchange waits on you. Act now or the job ends unresolved.`,
          )
          ballOn.since = Date.now()
          log(`nudge ${ballOn.name} (${used + 1}/2)`)
          ledger?.emit("reprompt", { member: ballOn.name, nudge: used + 1 })
        } else {
          dead.push(ballOn.name)
          ledger?.emit("wake", { why: `member ${ballOn.name} stalled past the nudge cap` })
          log(`member ${ballOn.name} stalled past the nudge cap — ending`)
        }
      }
    }
    for (const m of members) {
      if (dead.includes(m.name)) continue
      if (!port.paneAlive(m.name) && Date.now() - (bornAt.get(m.name) ?? 0) > 15_000) {
        dead.push(m.name)
        ledger?.emit("wake", { why: `member ${m.name} is dead` })
        log(`member ${m.name} is dead — ending the exchange`)
        say("watcher", `${m.name} dead`)
      }
    }
    if (dead.length > 0) {
      ended = "dead"
      break
    }
    await waitChange(join(taskDir, "messages"), 30_000)
  }
  if (!ended) ended = "deadline"
  const { messages } = readMessages(join(taskDir, "messages"), names)
  const rows = members.map((m) => ({
    unit: m.name,
    result: `${messages.filter((x) => x.from === m.name).length} messages`,
    pass: !dead.includes(m.name),
  }))
  if (ended !== "stop") rows.push({ unit: "exchange", result: `ended by ${ended}`, pass: false })
  log(`exchange ended (${ended}) — ${messages.length} messages, ${delivered.length} relayed`)
  const report = writeReport(
    taskDir,
    taskDir,
    rows,
    (table) => runCounts(taskDir, loadManifest(taskDir), table),
    ended === "stop" && dead.length === 0 ? "done" : undefined,
  )
  port.retireAll()
  if (verbosePane) herdr("pane", "close", verbosePane)
  return report
}

try {
  const checkMs = Number(process.env.AGENTIC_OS_CHECK_MS ?? "") || undefined
  const slots = Number(process.env.AGENTIC_OS_SLOTS ?? "") || undefined
  const existingRows = ledger
    ? readEvents(ledger.job.sid)
        .filter((e) => e.jid === ledger.job.id && e.kind === "unit.settled")
        .map((e) => ({ unit: String(e.unit), result: String(e.result ?? ""), pass: e.pass === true }))
    : undefined
  const report = await (workflowKindOf(taskDir) === "coworker" ? runCoworker() : runLive())
  log(`done: ${report.status}`)
  const reap = port.verify()
  // zen 5: the receipt counts THIS Job's panes, not the scope's
  const panesLeft = ledger ? ledger.job.panes.filter((p) => p.died === undefined).length : NaN
  log(`${reap} (scope); this job: ${panesLeft} of ${ledger?.job.panes.length ?? "?"} panes remain`)
  ledger?.finish({
    panesRemaining: panesLeft,
    panesTotal: ledger.job.panes.length,
    unitsDone: Number(report.counts?.units ?? NaN),
    unitsFailed: Number(report.counts?.failed ?? NaN),
    status: report.status,
    report: join(taskDir, "report.json"),
  })
} catch (err) {
  log(`fatal: ${err instanceof Error ? err.message : String(err)}`)
  ledger?.emit("fatal", { why: String(err instanceof Error ? err.message : err) })
  ledger?.abort(`fatal: ${err instanceof Error ? err.message : String(err)}`, mine.size)
  port.wake("fan-out", "blocked", `orchestrator died: ${taskDir}/orchestrator.log`)
  process.exit(1)
}
